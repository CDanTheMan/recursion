# Shape only. Real values live in .env (gitignored). Never commit credentials.

# Fallback route when the primary model (ChatGPT Pro sub) is unavailable.
# Also read by scripts/fallback-watch.sh to measure metered spend.
OPENROUTER_API_KEY=
# Where the supervisor sends the brief + escalations.
# (hermes send reuses ~/.hermes creds; these are the raw-API fallback path.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Repo location on the VPS.
RECURSION_ROOT=/opt/recursion
# --- Optional tuning (defaults shown) ---------------------------------------------
# OR_LOW_BALANCE_FLOOR=5      # warn when OpenRouter prepaid balance drops below $USD
# OR_SPEND_EPSILON=0.01       # $USD delta since last check that counts as "fell back"
# --- Engine plugins (D-015) — every flag is human-owned; the loop never writes these ------
# Master switch for declarative engine manifests under scripts/engines/ (default: off).
# RECURSION_ENGINE_PLUGINS=1
# Per-engine enablement (engine name uppercased, dashes -> underscores).
# RECURSION_ENGINE_GEMINI_ENABLED=1
# RECURSION_ENGINE_CURSOR_ENABLED=1
# RECURSION_ENGINE_OPENCODE_ENABLED=1
# RECURSION_ENGINE_OPENCODE_LOCAL_ENABLED=1
# Health URL for the Sentry-local arm (tunnel address; server down => tasks requeue).
# RECURSION_ENGINE_OPENCODE_LOCAL_HEALTH_URL=http://sentry.tail:8080/health
# Model alias values may be engine-qualified: "<engine>:<model>".
# RECURSION_MODEL_ALIAS_CURSOR_PRIMARY=cursor:gpt-5.2-codex
# RECURSION_MODEL_ALIAS_GEMINI_REVIEW=gemini:gemini-2.5-pro
# RECURSION_MODEL_ALIAS_OPENCODE_FLEX=opencode:deepseek/deepseek-v4
# RECURSION_MODEL_ALIAS_SENTRY_LOCAL=opencode-local:qwen3-30b-a3b
# --- esc-0001 close-out -------------------------------------------------------------------
# Autonomous merging is OFF. Nothing in scripts/ reads this any more; it stays as an explicit,
# human-owned tombstone and scripts/verify-branch-protection.py fails if it is ever 1 again.
RECURSION_ALLOW_AUTOMERGE=0
# Read-scope token for scripts/verify-branch-protection.py. Reading classic protection needs
# repo admin read; without a token every remote row reports UNVERIFIABLE, never "protected".
# GITHUB_TOKEN=
# RECURSION_GH_API_BASE is a TEST-ONLY hook (verify-branch-protection.test.py); never set it
# on the box.
# --- Usage/cost telemetry (scripts/usage-reconcile.py) ------------------------------------
# Opt-in for the ACCOUNT-LEVEL OpenRouter reconciliation subcommand. Off by default: the
# snapshot makes a real outbound request with OPENROUTER_API_KEY above (no second credential).
# Ingest and rollup never touch the network and ignore this flag.
# RECURSION_USAGE_OPENROUTER=1
# RECURSION_USAGE_OPENROUTER_URL is a TEST-ONLY hook (stub server); never set it on the box.
# --- Notification connectors (Component 6) — scaffolding only; every link is human-owned --
# Nothing below is set on the box. A connector cannot execute unless ALL of these are set
# AND scripts/connector-transport.py is made executable. notify.sh is unmodified.
# Master switch for declarative connector manifests under scripts/connectors/ (default: off).
# RECURSION_CONNECTORS=1
# Per-connector enablement (connector name uppercased, dashes -> underscores).
# RECURSION_CONNECTOR_TELEGRAM_ALT_ENABLED=1
# Which connector connector-transport.py resolves when notify.sh invokes it.
# RECURSION_CONNECTOR_ACTIVE=telegram-alt
# The actual switch: an EXISTING, currently-unset hook in notify.sh. While unset, notify.sh
# uses its built-in Telegram path and no connector can run, regardless of the flags above.
# RECURSION_NOTIFY_TRANSPORT=/opt/recursion/scripts/connector-transport.py
