{
  "version": 1,
  "review": {
    "max_rounds": 1,
    "accept_unreviewed": false
  },
  "landing": {
    "base_ref": "HEAD",
    "conflict_retries": 1
  },
  "budgets": {
    "max_input_tokens": 1000000,
    "max_output_tokens": 1000000,
    "max_cost": null
  },
  "orchestration": {
    "concurrency": 2
  },
  "routing": {
    "required_capabilities": ["execute"],
    "preference": ["claude", "codex", "grok", "fixture", "fixture-b", "gemini", "cursor", "opencode"],
    "retries": 0,
    "backoff_seconds": 0,
    "cooldown_seconds": 60,
    "weights": {
      "fixture": 1,
      "fixture-b": 1,
      "claude": 1,
      "codex": 1,
      "grok": 1,
      "gemini": 1,
      "cursor": 1,
      "opencode": 1
    }
  },
  "providers": [
    {
      "name": "fixture",
      "enabled": false,
      "capabilities": ["execute", "deterministic"],
      "argv": ["fixture-provider", "--output-format", "json"],
      "timeout_seconds": 30
    },
    {
      "name": "fixture-b",
      "enabled": false,
      "capabilities": ["execute", "deterministic"],
      "argv": ["fixture-b-provider", "--output-format", "json"],
      "timeout_seconds": 30
    },
    {
      "name": "claude",
      "enabled": true,
      "capabilities": ["execute", "stream-json", "subscription"],
      "argv": ["claude", "-p", "--output-format", "stream-json", "--verbose", "--dangerously-skip-permissions"],
      "timeout_seconds": 30
    },
    {
      "name": "codex",
      "enabled": true,
      "capabilities": ["execute", "jsonl", "subscription"],
      "argv": ["codex", "exec", "--json", "--approve-for-me"],
      "timeout_seconds": 30
    },
    {
      "name": "grok",
      "enabled": true,
      "capabilities": ["execute", "streaming-json", "subscription"],
      "argv": ["grok", "--output-format", "streaming-json", "--always-approve", "--no-auto-update"],
      "timeout_seconds": 30
    },
    {
      "name": "gemini",
      "enabled": false,
      "capabilities": ["execute", "stream-json", "subscription"],
      "argv": ["gemini", "-p", "--output-format", "stream-json", "--approval-mode", "yolo", "--skip-trust"],
      "timeout_seconds": 30
    },
    {
      "name": "cursor",
      "enabled": false,
      "capabilities": ["execute", "stream-json", "subscription"],
      "argv": ["cursor-agent", "-p", "--output-format", "stream-json", "--force", "--trust"],
      "timeout_seconds": 30
    },
    {
      "name": "opencode",
      "enabled": false,
      "capabilities": ["execute", "json"],
      "argv": ["opencode", "run", "--format", "json", "--auto"],
      "timeout_seconds": 30
    }
  ]
}
