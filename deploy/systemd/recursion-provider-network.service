[Unit]
Description=Recursion provider-only network namespace
Before=recursion-provider-proxy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/recursion/scripts/provider-network.sh create
ExecStart=/opt/recursion/scripts/provider-network.sh namespace-check
ExecStop=/opt/recursion/scripts/provider-network.sh delete
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

[Install]
WantedBy=multi-user.target
