[Unit]
Description=Recursion profile-driven provider-only CONNECT proxy (Phase 4 template)
Requires=recursion-provider-network.service
BindsTo=recursion-provider-network.service
After=recursion-provider-network.service network-online.target

[Service]
Type=exec
User=root
ExecStartPre=/opt/recursion/scripts/provider-network.sh namespace-check
ExecStart=/opt/recursion/scripts/provider-connect-proxy.py serve --namespace /run/netns/recursion-provider-only --listen-port 18080 --profile-dir /etc/recursion/providers --profile anthropic --profile cursor --profile google-gemini --profile openrouter-via-opencode --drop-user recursion-provider-proxy --concurrency 16
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_SETPCAP
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
LimitNOFILE=256
TasksMax=64
MemoryHigh=128M
MemoryMax=256M
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
# Deliberately no WantedBy: provider profiles and firewall policy are human-owned.
