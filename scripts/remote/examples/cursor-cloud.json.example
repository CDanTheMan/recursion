{
  "schema_version": 1,
  "name": "cursor-cloud",
  "kind": "cursor-cloud",
  "description": "Cursor Cloud Agents: isolated vendor VM, own capacity pool. API field names in scripts/cursor-cloud-adapter.py are PROVISIONAL until verified against the live API during the human-gated deployment step -- measure, don't assume.",
  "endpoint": "https://api.cursor.com",
  "endpoint_ref": null,
  "credential_ref": "secret:CURSOR_CLOUD_API_KEY",
  "signing_key_ref": null,
  "capacity_pool": "cursor-cloud-pool",
  "host_id": "cursor-cloud",
  "billing_basis": "included",
  "on_demand": false,
  "timeout_seconds": 60,
  "max_attempts": 3,
  "concurrency_lease": 2,
  "publication": {
    "default_branch": "main",
    "integration_branch": "recursion/integration",
    "task_branch_pattern": "recursion/extern/<task-id>",
    "allowed_result_branch_patterns": [
      "recursion/extern/*",
      "cursor/*"
    ]
  }
}
