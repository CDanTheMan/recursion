{
  "schema_version": 1,
  "name": "cursor",
  "description": "Cursor CLI (cursor-agent), headless print mode. Real Cursor execution remains unproven until the required runner-home auth marker is present and a human-owned on-box probe verifies the declared flags.",
  "executable": "cursor-agent",
  "argv": [
    "{{EXE}}",
    "-p",
    "--trust",
    "{{PROMPT}}",
    "--output-format",
    "text",
    "--force"
  ],
  "model": {
    "required": true,
    "argv_suffix": [
      "--model",
      "{{MODEL}}"
    ]
  },
  "roles": [
    "implementer",
    "verifier"
  ],
  "billing": {
    "basis": "flat-subscription",
    "provider": "cursor"
  },
  "network": {
    "policy": "provider-only",
    "profile": "cursor",
    "endpoints": [
      "api.cursor.com",
      "api2.cursor.sh",
      "agentn.global.api5.cursor.sh",
      "agentn.global.api5lat.cursor.sh",
      "agentn.global.api5geo.cursor.sh"
    ]
  },
  "availability_probe": null,
  "concurrency_cap": null,
  "env_passthrough": [],
  "runtime_layout": {
    "mode": "sibling-tree",
    "source": "executable-directory",
    "target": ".recursion-runtime",
    "entrypoint": "cursor-agent"
  },
  "execution": {
    "structured_output": false,
    "output_format": "text",
    "cancellation": { "signal": "TERM", "grace_s": 5 },
    "exit_codes": {
      "success": [0],
      "auth": [1, 2],
      "runtime": [126, 127],
      "egress": [60, 65]
    }
  },
  "auth": { "mode": "runner-home-marker", "required": true, "marker": ".cursor" }
}
