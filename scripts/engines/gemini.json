{
  "schema_version": 1,
  "name": "gemini",
  "description": "Google Gemini CLI, headless. Argv is provisional pending on-box flag verification (docs/plans/engine-plugin-architecture.md, deployment step 2) -- measure, don't assume.",
  "executable": "gemini",
  "argv": ["{{EXE}}", "-p", "{{PROMPT}}", "--yolo"],
  "model": { "required": false, "argv_suffix": ["--model", "{{MODEL}}"] },
  "roles": ["implementer", "verifier"],
  "billing": { "basis": "metered", "provider": "google-gemini" },
  "network": { "policy": "provider-only", "profile": "gemini", "endpoints": ["generativelanguage.googleapis.com"] },
  "availability_probe": null,
  "concurrency_cap": null,
  "env_passthrough": ["GEMINI_API_KEY"]
}
