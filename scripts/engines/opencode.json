{
  "schema_version": 1,
  "name": "opencode",
  "description": "OpenCode CLI fronting OpenRouter/DeepSeek/any OpenAI-compatible provider; supersedes the stubbed deepseek/openrouter engines. Argv is provisional pending on-box flag verification (docs/plans/engine-plugin-architecture.md, deployment step 2) -- measure, don't assume.",
  "executable": "opencode",
  "argv": [
    "{{EXE}}",
    "run",
    "--",
    "{{PROMPT}}"
  ],
  "model": {
    "required": true,
    "argv_suffix": [
      "--model",
      "{{MODEL}}"
    ]
  },
  "roles": [
    "implementer",
    "verifier"
  ],
  "billing": {
    "basis": "metered",
    "provider": "openrouter-via-opencode"
  },
  "network": {
    "policy": "provider-only",
    "profile": "openrouter",
    "endpoints": [
      "openrouter.ai",
      "api.deepseek.com"
    ]
  },
  "availability_probe": null,
  "concurrency_cap": null,
  "env_passthrough": [
    "OPENROUTER_API_KEY"
  ],
  "runtime_layout": { "mode": "executable-only" },
  "execution": {
    "structured_output": false,
    "output_format": "text",
    "cancellation": { "signal": "TERM", "grace_s": 5 },
    "exit_codes": { "success": [0], "auth": [1, 2], "runtime": [126, 127], "egress": [60, 65] }
  },
  "auth": { "mode": "none", "required": false, "marker": null }
}
