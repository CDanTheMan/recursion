{
  "schema_version": 1,
  "name": "opencode-local",
  "description": "OpenCode CLI pointed at a Qwen 30B-class local OpenAI-compatible server on the Sentry PC, reached over the tunnel. Argv is provisional pending on-box flag verification (docs/plans/engine-plugin-architecture.md, deployment step 2) -- measure, don't assume.",
  "executable": "opencode",
  "argv": [
    "{{EXE}}",
    "run",
    "--",
    "{{PROMPT}}"
  ],
  "model": {
    "required": true,
    "argv_suffix": [
      "--model",
      "{{MODEL}}"
    ]
  },
  "roles": [
    "implementer"
  ],
  "billing": {
    "basis": "local",
    "provider": "sentry-local"
  },
  "network": {
    "policy": "provider-only",
    "profile": "sentry-local",
    "endpoints": []
  },
  "availability_probe": {
    "type": "http",
    "url_env": "RECURSION_ENGINE_OPENCODE_LOCAL_HEALTH_URL",
    "timeout_s": 5
  },
  "concurrency_cap": 1,
  "env_passthrough": [],
  "runtime_layout": { "mode": "executable-only" },
  "execution": {
    "structured_output": false,
    "output_format": "text",
    "cancellation": { "signal": "TERM", "grace_s": 5 },
    "exit_codes": { "success": [0], "auth": [1, 2], "runtime": [126, 127], "egress": [60, 65] }
  },
  "auth": { "mode": "none", "required": false, "marker": null }
}
