{
  "schema_version": 1,
  "profiles": {
    "anthropic": {
      "provider": "anthropic-claude-code",
      "namespace": "recursion-provider-anthropic",
      "proxy_port": 18080,
      "endpoints": ["api.anthropic.com"],
      "env_allowlist": ["ANTHROPIC_API_KEY", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"]
    },
    "cursor": {
      "provider": "cursor",
      "namespace": "recursion-provider-cursor",
      "proxy_port": 18081,
      "endpoints": ["api.cursor.com", "api2.cursor.sh"],
      "env_allowlist": []
    },
    "gemini": {
      "provider": "google-gemini",
      "namespace": "recursion-provider-gemini",
      "proxy_port": 18082,
      "endpoints": ["generativelanguage.googleapis.com"],
      "env_allowlist": ["GEMINI_API_KEY"]
    },
    "openrouter": {
      "provider": "openrouter-via-opencode",
      "namespace": "recursion-provider-openrouter",
      "proxy_port": 18083,
      "endpoints": ["openrouter.ai", "api.deepseek.com"],
      "env_allowlist": ["OPENROUTER_API_KEY"]
    },
    "sentry-local": {
      "provider": "sentry-local",
      "namespace": "recursion-provider-sentry-local",
      "proxy_port": 18084,
      "endpoints": [],
      "env_allowlist": []
    }
  }
}
