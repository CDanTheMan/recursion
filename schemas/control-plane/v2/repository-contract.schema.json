{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursion.local/schemas/control-plane/v2/repository-contract.schema.json",
  "title": "Recursion v2 project repository contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "repo", "default_branch", "integration_branch", "task_branch_pattern",
    "external_branch_patterns", "publication_policy", "source_policy", "allowed_paths",
    "gate_commands", "eligible_hosts", "eligible_pools"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "repo": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\u0000-\\u001F])\\S(?:.*\\S)?$"},
    "default_branch": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*@\\{)(?!.*//)(?!.*\\/$)(?!.*\\.lock$)(?!.*(?:^|/)\\.)(?!.*(?:^|/)\\.lock(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "integration_branch": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*@\\{)(?!.*//)(?!.*\\/$)(?!.*\\.lock$)(?!.*(?:^|/)\\.)(?!.*(?:^|/)\\.lock(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "task_branch_pattern": {"type": "string", "pattern": "^(?!.*\\.\\.)(?!.*@\\{)(?!.*//)(?!/)(?!.*/$)(?!.*(?:^|/)\\.)(?!.*\\.lock(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*\\{task_id\\}[A-Za-z0-9._/-]*$"},
    "external_branch_patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^(?!.*\\.\\.)(?!.*@\\{)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.)(?!.*\\.lock(?:/|$))[A-Za-z0-9][A-Za-z0-9._/*-]{0,199}$"}},
    "publication_policy": {"const": "verified-integration-only"},
    "source_policy": {"const": "exact-sha"},
    "gate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"anyOf": [{"const": "."}, {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\u0000-\\u001F])(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.?([/]|$))(?!.*[/\\\\]$)(?!^\\s)(?!.*\\s$).+$"}]}},
    "gate_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "One or more direct, non-vacuous gate commands joined only by &&. This mirrors validate-gate.py --strict-direct: every segment must start with an admitted command, separators cannot be empty/trailing/triple, and shell indirection, traversal, absolute operands, Git redirection, and dynamic interpreters remain refused.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^(?!.*[\\x00-\\x08\\x0A-\\x1F])(?!.*\\.recursion-result\\.json)(?!.*(?:^|[\\s\\\"'])(?:/|[A-Za-z]:[/\\\\]))(?!.*(?:^|[/\\\\\\s\\\"'])\\.\\.(?:[/\\\\\\s\\\"']|$))(?!.*(?:^|\\s)[\\\"']-)(?!.*(?:^|&&)\\s*(?:bash|sh|python|python3|node)\\s*(?:&&|$))(?!.*(?:^|&&)\\s*(?:bash|sh|python|python3|node)\\s+-)(?!.*(?:^|&&)\\s*(?:test|\\[)\\s+-n(?:\\s|$))(?!.*(?:^|&&)\\s*(?:test|\\[)(?:(?!&&).)*\\s(?:=|==|-eq)\\s)(?!.*(?:^|&&)\\s*git(?:(?!&&).)*\\s(?:-C|-c|-o|--(?:git-dir|work-tree|super-prefix|exec-path|namespace|config|config-env|output))[^\\s&]*(?=\\s|&&|$))\\s*(?:test|\\[|git|bash|sh|python|python3|node)(?:\\s+(?:[^\\s&|<>`$(){};'\\\"]+|\"[^\"&|<>`$(){};\\r\\n]+\"|'[^'&|<>`$(){};\\r\\n]+'))*(?:\\s*&&\\s*(?:test|\\[|git|bash|sh|python|python3|node)(?:\\s+(?:[^\\s&|<>`$(){};'\\\"]+|\"[^\"&|<>`$(){};\\r\\n]+\"|'[^'&|<>`$(){};\\r\\n]+'))*)*\\s*$"
      }
    },
    "eligible_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F]+$"}},
    "eligible_pools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F]+$"}}
  }
}
