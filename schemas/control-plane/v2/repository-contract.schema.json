{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursion.local/schemas/control-plane/v2/repository-contract.schema.json",
  "title": "Recursion v2 project repository contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "repo", "default_branch", "integration_branch", "task_branch_pattern",
    "external_branch_patterns", "publication_policy", "source_policy", "allowed_paths",
    "gate_commands", "eligible_hosts", "eligible_pools"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "repo": {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\u0000-\\u001F])\\S(?:.*\\S)?$"},
    "default_branch": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!.*//)(?!.*\\.\\.)(?!.*@\\{)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*(?:^|/)\\.)(?!.*\\.$)(?!.*/$)[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "integration_branch": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!.*//)(?!.*\\.\\.)(?!.*@\\{)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*(?:^|/)\\.)(?!.*\\.$)(?!.*/$)[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "task_branch_pattern": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!.*//)(?!.*\\.\\.)(?!.*@\\{)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*(?:^|/)\\.)(?!.*\\.$)(?!.*\\{task_id\\}.*\\{task_id\\})[A-Za-z0-9][A-Za-z0-9._/-]*\\{task_id\\}[A-Za-z0-9._/-]*$"},
    "external_branch_patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "allOf": [{"not": {"contains": {"const": "recursion/*"}}}], "items": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!\\*{1,2}$)(?!.*//)(?!.*\\.\\.)(?!.*@\\{)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*(?:^|/)\\.)(?!.*\\.$)[A-Za-z0-9][A-Za-z0-9._/*-]{0,199}$"}},
    "publication_policy": {"const": "verified-integration-only"},
    "source_policy": {"const": "exact-sha"},
    "gate_digest": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "allOf": [{"not": {"contains": {"pattern": "[~%$`*?\\[]"}}}, {"not": {"contains": {"pattern": "^(?:[A-Za-z]:|/|\\\\\\\\|//)"}}}], "items": {"anyOf": [{"const": "."}, {"type": "string", "minLength": 1, "pattern": "^(?!.*[\\u0000-\\u001F])(?!.*[~%$`*?\\[])(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(^|/)\\.\\.?([/]|$))(?!.*[/\\\\]$)(?!^\\s)(?!.*\\s$).+$"}]}},
    "gate_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "One or more direct, non-vacuous gate commands joined only by &&. This mirrors validate-gate.py --strict-direct: every segment must start with an admitted command, separators cannot be empty/trailing/triple, and shell indirection, traversal, absolute operands, Git redirection, and dynamic interpreters remain refused.",
      "allOf": [
        {"not": {"contains": {"pattern": "[~%$`]"}}},
        {"not": {"contains": {"pattern": "\\s(?!(?:\\[)(?:\\s|$))[^\\s&|]*[*?\\[]"}}},
        {"not": {"contains": {"pattern": "(?:^|[\\s\"'])(?:[A-Za-z]:|\\\\\\\\|//)"}}},
        {"not": {"contains": {"pattern": "(?:^|&&)\\s*git\\s+-"}}},
        {"not": {"contains": {"pattern": "(?:^|&&)\\s*git\\s+(?!(?:diff|status|show|rev-parse|ls-files|cat-file)(?:\\s|$))[^\\s&]+(?:\\s|$)"}}},
        {"not": {"contains": {"pattern": "(?:^|&&)\\s*git\\s+(?:diff|status)(?:\\s|$)[^&]*(?:--no-index(?:=|\\s|$)|--pathspec-from-file(?:=|\\s|$)|--pathspec-file-nul(?:\\s|$))"}}},
        {"not": {"contains": {"pattern": "(?:^|&&)\\s*(?:test|\\[)(?:(?!&&).)*\\s-(?:ef|nt|ot)(?:\\s|$)"}}}
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "allOf": [
          {"not": {"pattern": "[~%$`]"}},
          {"not": {"pattern": "\\s(?!(?:\\[)(?:\\s|$))[^\\s&|]*[*?\\[]"}},
          {"not": {"pattern": "(?:^|[\\s\"'])(?:[A-Za-z]:|\\\\\\\\|//)"}},
          {"not": {"pattern": "(?:^|&&)\\s*git\\s+-"}},
          {"not": {"pattern": "(?:^|&&)\\s*git\\s+(?!(?:diff|status|show|rev-parse|ls-files|cat-file)(?:\\s|$))[^\\s&]+(?:\\s|$)"}},
          {"not": {"pattern": "(?:^|&&)\\s*git\\s+(?:diff|status)(?:\\s|$)[^&]*(?:--no-index(?:=|\\s|$)|--pathspec-from-file(?:=|\\s|$)|--pathspec-file-nul(?:\\s|$))"}},
          {"not": {"pattern": "(?:^|&&)\\s*(?:test|\\[)(?:(?!&&).)*\\s-(?:ef|nt|ot)(?:\\s|$)"}}
        ],
        "pattern": "^(?!.*[\\x00-\\x08\\x0A-\\x1F])(?!.*\\.recursion-result\\.json)(?!.*(?:^|[\\s\\\"'])\\\\\\\\)(?!.*(?:^|[\\s\\\"']|[/\\\\])\\./)(?!.*(?:^|[\\s\\\"'])(?:/|[A-Za-z]:[/\\\\]))(?!.*(?:^|[/\\\\\\s\\\"'])\\.\\.(?:[/\\\\\\s\\\"']|$))(?!.*(?:^|\\s)[\\\"']-)(?!.*(?:^|&&)\\s*(?:bash|sh|python|python3|node)\\s*(?:&&|$))(?!.*(?:^|&&)\\s*(?:bash|sh|python|python3|node)\\s+-)(?!.*(?:^|&&)\\s*(?:test|\\[)\\s+-n(?:\\s|$))(?!.*(?:^|&&)\\s*(?:test|\\[)(?:(?!&&).)*\\s(?:=|==|-eq)\\s)(?!.*(?:^|&&)\\s*git(?:(?!&&).)*\\s(?:-C|-c|-o|--(?:git-dir|work-tree|super-prefix|exec-path|namespace|config|config-env|output))[^\\s&]*(?=\\s|&&|$))\\s*(?:test|\\[|git|bash|sh|python|python3|node)(?:\\s+(?:[^\\s&|<>`$(){};'\\\"]+|\"[^\"&|<>`$(){};\\r\\n]+\"|'[^'&|<>`$(){};\\r\\n]+'))*(?:\\s*&&\\s*(?:test|\\[|git|bash|sh|python|python3|node)(?:\\s+(?:[^\\s&|<>`$(){};'\\\"]+|\"[^\"&|<>`$(){};\\r\\n]+\"|'[^'&|<>`$(){};\\r\\n]+'))*)*\\s*$"
      }
    },
    "required_gate_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance", "gate_class", "gate_files", "controller_gate_files"],
      "allOf": [
        {"not": {"properties": {"acceptance": {"pattern": "^\\s*(?:true|:|/bin/true|exit\\s+0|echo(?:\\s|$)|printf(?:\\s|$)|pwd(?:\\s|$))"}}}},
        {"if": {"properties": {"acceptance": {"pattern": "^\\s*(?:bash|sh|python|python3|node)\\s+"}}}, "then": {"anyOf": [{"properties": {"gate_files": {"minItems": 1}}}, {"properties": {"controller_gate_files": {"minItems": 1}}}]}},
        {"if": {"properties": {"acceptance": {"pattern": "^\\s*(?:/|[A-Za-z]:[/\\\\])"}}}, "then": {"properties": {"controller_gate_files": {"minItems": 1}}}},
        {"not": {"properties": {"acceptance": {"pattern": "(?:^|&&)\\s*git\\s+(?!(?:diff|status|show|rev-parse|ls-files|cat-file)(?:\\s|$))"}}}}
      ],
      "properties": {
        "acceptance": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!.*[\\u0000-\\u001F])(?!.*[~%$`])(?:(?!;|\\|).)*$"},
        "gate_class": {"enum": ["light", "heavy"]},
        "gate_files": {"type": "array", "uniqueItems": true, "allOf": [{"not": {"contains": {"pattern": "[~%$`*?\\[]"}}}, {"not": {"contains": {"pattern": "^(?:[A-Za-z]:|/|\\\\\\\\|//)"}}}], "items": {"type": "string", "minLength": 1, "pattern": "^(?!\\.$)(?!.*[\\u0000-\\u001F])(?!.*[\\s,])(?!.*[~%$`*?\\[])(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(^|/)\\.\\.?([/]|$))(?!.*[/\\\\]$)(?!^\\s)(?!.*\\s$).+$"}},
        "controller_gate_files": {"type": "array", "uniqueItems": true, "allOf": [{"not": {"contains": {"pattern": "[~%$`*?\\[]"}}}, {"not": {"contains": {"pattern": "^(?:[A-Za-z]:|/|\\\\\\\\|//)"}}}], "items": {"type": "string", "minLength": 1, "pattern": "^(?!\\.$)(?!.*[\\u0000-\\u001F])(?!.*[\\s,])(?!.*[~%$`*?\\[])(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(^|/)\\.\\.?([/]|$))(?!.*[/\\\\]$)(?!^\\s)(?!.*\\s$).+$"}}
      }
    },
    "eligible_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F]+$"}},
    "eligible_pools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F]+$"}}
  },
  "allOf": [
    {"if": {"properties": {"default_branch": {"const": "main"}}}, "then": {"properties": {"integration_branch": {"not": {"const": "main"}}}}},
    {"if": {"properties": {"default_branch": {"const": "master"}}}, "then": {"properties": {"integration_branch": {"not": {"const": "master"}}}}},
    {"if": {"properties": {"default_branch": {"const": "develop"}}}, "then": {"properties": {"integration_branch": {"not": {"const": "develop"}}}}},
    {"if": {"properties": {"default_branch": {"const": "trunk"}}}, "then": {"properties": {"integration_branch": {"not": {"const": "trunk"}}}}},
    {"if": {"required": ["gate_commands", "required_gate_profile"], "properties": {"gate_commands": {"const": ["git diff --check"]}, "required_gate_profile": {"properties": {"acceptance": {"not": {"const": "git diff --check"}}}}}}, "then": {"not": {"required": ["required_gate_profile"]}}}
  ]
}
