{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://recursion.local/schemas/control-plane/v2/task.schema.json","title":"Recursion v2 task contract","type":"object","additionalProperties":false,"required":["schema_version","kind","id","project_id","source_repository","source_branch","source_sha","parent_goal","parent_task_id","parent_task_digest","depth","allowed_paths","non_goals","acceptance","requested_capabilities","budget_id","verification_policy","gate_digest","created_at","expires_at","task_digest"],"properties":{"schema_version":{"const":2},"kind":{"const":"task"},"id":{"$ref":"#/$defs/id"},"project_id":{"$ref":"#/$defs/id"},"source_repository":{"$ref":"#/$defs/safe"},"source_branch":{"$ref":"#/$defs/safe"},"source_sha":{"$ref":"#/$defs/sha"},"parent_goal":{"$ref":"#/$defs/id"},"parent_task_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"parent_task_digest":{"anyOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"depth":{"$ref":"#/$defs/nonnegative","maximum":2},"allowed_paths":{"$ref":"#/$defs/paths"},"non_goals":{"$ref":"#/$defs/strings"},"acceptance":{"$ref":"#/$defs/safe"},"requested_capabilities":{"$ref":"#/$defs/strings"},"budget_id":{"$ref":"#/$defs/id"},"verification_policy":{"$ref":"#/$defs/safe"},"gate_digest":{"$ref":"#/$defs/digest"},"created_at":{"$ref":"#/$defs/time"},"expires_at":{"anyOf":[{"$ref":"#/$defs/time"},{"type":"null"}]},"task_digest":{"$ref":"#/$defs/digest"}},"$defs":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,63}$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"safe":{"type":"string","minLength":1,"maxLength":65536,"not":{"pattern":"(?:sk-[A-Za-z0-9_-]{12,}|gh[pousr]_[A-Za-z0-9_-]{12,}|github_pat_[A-Za-z0-9_]{12,}|xox[baprs]-[A-Za-z0-9-]{12,}|AKIA[0-9A-Z]{16}|npm_[A-Za-z0-9]{12,}|AIza[0-9A-Za-z_-]{20,}|bearer[ \\t]+[^ \\t]+|(?:api[_-]?key|password|secret|token)[ \\t]*[:=]|-----BEGIN [A-Z ]+ KEY-----)"}},"time":{"type":"string","format":