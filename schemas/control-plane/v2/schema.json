{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursion.local/schemas/control-plane/v2/schema.json",
  "title": "Recursion execution fabric contracts v2",
  "description": "Strict declarative records. Validators reject unknown fields and secret material.",
  "oneOf": [
    { "$ref": "#/$defs/engine" }, { "$ref": "#/$defs/provider" },
    { "$ref": "#/$defs/capacity_pool" }, { "$ref": "#/$defs/model" },
    { "$ref": "#/$defs/host" }, { "$ref": "#/$defs/sandbox_profile" },
    { "$ref": "#/$defs/routing_policy" }, { "$ref": "#/$defs/project" },
    { "$ref": "#/$defs/assignment" }, { "$ref": "#/$defs/registry" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "base": {
      "type": "object", "required": ["schema_version", "kind", "id"],
      "properties": { "schema_version": { "const": 2 }, "kind": { "type": "string" }, "id": { "$ref": "#/$defs/id" } },
      "additionalProperties": false
    },
    "registry": {
      "type": "object", "required": ["schema_version", "registry", "entries"],
      "properties": {
        "schema_version": { "const": 2 },
        "registry": { "enum": ["engine", "provider", "capacity_pool", "model", "host", "sandbox_profile", "routing_policy", "project", "assignment"] },
        "entries": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }, "additionalProperties": false
    },
    "engine": {
      "type": "object", "required": ["schema_version", "kind", "id", "description", "runtime_layout", "argv_template", "structured_output", "roles", "capabilities", "cancellation", "resume", "usage_receipt", "network_capabilities", "compatible_sandbox_profiles", "compatible_host_capabilities"],
      "properties": {
        "schema_version": { "const": 2 }, "kind": { "const": "engine" }, "id": { "$ref": "#/$defs/id" }, "description": { "type": "string", "minLength": 1 },
        "runtime_layout": { "type": "object", "required": ["kind", "executable", "runtime_paths", "read_only_mounts"], "properties": { "kind": { "enum": ["bare", "runtime-tree"] }, "executable": { "type": "string", "minLength": 1 }, "runtime_paths": { "$ref": "#/$defs/strings" }, "read_only_mounts": { "$ref": "#/$defs/strings" } }, "additionalProperties": false },
        "argv_template": { "$ref": "#/$defs/strings" }, "structured_output": { "type": "boolean" }, "roles": { "$ref": "#/$defs/strings" }, "capabilities": { "$ref": "#/$defs/strings" }, "health_probe": { "type": ["object", "null"] }, "cancellation": { "type": "object" }, "resume": { "type": "object" }, "usage_receipt": { "type": "object" }, "network_capabilities": { "$ref": "#/$defs/strings" }, "compatible_sandbox_profiles": { "$ref": "#/$defs/strings" }, "compatible_host_capabilities": { "$ref": "#/$defs/strings" }, "enabled": { "type": "boolean" }
      }, "additionalProperties": false
    },
    "provider": { "type": "object", "required": ["schema_version", "kind", "id", "endpoints", "egress_profile", "receipt_semantics", "error_classes", "data_classification"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "provider" }, "id": { "$ref": "#/$defs/id" }, "endpoints": { "$ref": "#/$defs/strings" }, "egress_profile": { "type": "string" }, "receipt_semantics": { "type": "string" }, "error_classes": { "$ref": "#/$defs/strings" }, "data_classification": { "type": "string" } }, "additionalProperties": false },
    "capacity_pool": { "type": "object", "required": ["schema_version", "kind", "id", "account_id", "billing_basis", "credential_ref", "roles", "quota", "on_demand", "initial_concurrency", "fallback_policy", "status"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "capacity_pool" }, "id": { "$ref": "#/$defs/id" }, "account_id": { "type": "string" }, "billing_basis": { "enum": ["included", "weekly-included", "metered", "local", "human"] }, "credential_ref": { "type": "string", "pattern": "^secret:[a-z][a-z0-9._/-]{1,127}$" }, "roles": { "$ref": "#/$defs/strings" }, "projects": { "$ref": "#/$defs/strings" }, "models": { "$ref": "#/$defs/strings" }, "hosts": { "$ref": "#/$defs/strings" }, "quota": { "type": "object" }, "spend_ceiling_usd": { "type": "integer", "minimum": 0 }, "on_demand": { "type": "boolean" }, "initial_concurrency": { "type": "integer", "minimum": 1 }, "cooldown_s": { "type": "integer", "minimum": 0 }, "fallback_policy": { "type": "string" }, "status": { "type": "string" } }, "additionalProperties": false },
    "model": { "type": "object", "required": ["schema_version", "kind", "id", "provider_ids", "engine_ids", "roles", "data_classes", "capabilities", "reasoning_class", "speed_class", "cost_class", "efforts", "context_tokens", "status"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "model" }, "id": { "$ref": "#/$defs/id" }, "provider_ids": { "$ref": "#/$defs/strings" }, "engine_ids": { "$ref": "#/$defs/strings" }, "roles": { "$ref": "#/$defs/strings" }, "data_classes": { "$ref": "#/$defs/strings" }, "capabilities": { "$ref": "#/$defs/strings" }, "reasoning_class": { "type": "string" }, "speed_class": { "type": "string" }, "cost_class": { "type": "string" }, "efforts": { "$ref": "#/$defs/strings" }, "context_tokens": { "type": "integer", "minimum": 1 }, "status": { "type": "string" } }, "additionalProperties": false },
    "host": { "type": "object", "required": ["schema_version", "kind", "id", "class", "operating_system", "architecture", "cpu", "ram_mb", "disk_mb", "gpu", "gui", "engine_ids", "sandbox_profile_ids", "capabilities", "network_profiles", "concurrency", "heartbeat", "recovery", "trust_class", "status"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "host" }, "id": { "$ref": "#/$defs/id" }, "class": { "type": "string" }, "operating_system": { "type": "string" }, "architecture": { "type": "string" }, "cpu": { "type": "string" }, "ram_mb": { "type": "integer", "minimum": 1 }, "disk_mb": { "type": "integer", "minimum": 1 }, "gpu": { "type": "string" }, "gui": { "type": "boolean" }, "engine_ids": { "$ref": "#/$defs/strings" }, "sandbox_profile_ids": { "$ref": "#/$defs/strings" }, "capabilities": { "$ref": "#/$defs/strings" }, "network_profiles": { "$ref": "#/$defs/strings" }, "concurrency": { "type": "integer", "minimum": 1 }, "heartbeat": { "type": "object" }, "recovery": { "type": "object" }, "trust_class": { "type": "string" }, "status": { "type": "string" } }, "additionalProperties": false },
    "sandbox_profile": { "type": "object", "required": ["schema_version", "kind", "id", "isolation", "operating_system", "write_scope", "network_profiles", "capabilities", "trust_class", "controller_visibility"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "sandbox_profile" }, "id": { "$ref": "#/$defs/id" }, "isolation": { "type": "string" }, "operating_system": { "type": "string" }, "write_scope": { "type": "string" }, "network_profiles": { "$ref": "#/$defs/strings" }, "capabilities": { "$ref": "#/$defs/strings" }, "trust_class": { "type": "string" }, "controller_visibility": { "type": "string" } }, "additionalProperties": false },
    "routing_policy": { "type": "object", "required": ["schema_version", "kind", "id", "policy", "role", "candidate_order", "allow_metered", "fallback_policy"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "routing_policy" }, "id": { "$ref": "#/$defs/id" }, "policy": { "type": "string" }, "role": { "type": "string" }, "candidate_order": { "$ref": "#/$defs/strings" }, "allow_metered": { "type": "boolean" }, "fallback_policy": { "type": "string" }, "weights": { "type": "object" } }, "additionalProperties": false },
    "project": { "type": "object", "required": ["schema_version", "kind", "id", "repository", "default_branch", "integration_branch", "task_branch_pattern", "external_branch_patterns", "publication_policy", "source_policy", "allowed_paths", "gate_commands", "eligible_hosts", "eligible_pools", "status"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "project" }, "id": { "$ref": "#/$defs/id" }, "repository": { "type": "string" }, "default_branch": { "type": "string" }, "integration_branch": { "type": "string" }, "task_branch_pattern": { "type": "string" }, "external_branch_patterns": { "$ref": "#/$defs/strings" }, "publication_policy": { "const": "verified-integration-only" }, "source_policy": { "const": "exact-sha" }, "allowed_paths": { "$ref": "#/$defs/strings" }, "gate_commands": { "$ref": "#/$defs/strings" }, "eligible_hosts": { "$ref": "#/$defs/strings" }, "eligible_pools": { "$ref": "#/$defs/strings" }, "status": { "type": "string" } }, "additionalProperties": false },
    "assignment": { "type": "object", "required": ["schema_version", "kind", "id", "task_id", "project_id", "source_repository", "source_branch", "source_sha", "seed_manifest_digest", "engine_id", "provider_id", "capacity_pool_id", "model_id", "model_parameters", "host_id", "sandbox_profile_id", "network_profile", "allowed_paths", "gate_digest", "publication_policy", "created_at", "assignment_digest"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "assignment" }, "id": { "$ref": "#/$defs/id" }, "task_id": { "type": "string" }, "project_id": { "$ref": "#/$defs/id" }, "source_repository": { "type": "string" }, "source_branch": { "type": "string" }, "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }, "seed_manifest_digest": { "$ref": "#/$defs/sha256" }, "engine_id": { "$ref": "#/$defs/id" }, "provider_id": { "$ref": "#/$defs/id" }, "capacity_pool_id": { "$ref": "#/$defs/id" }, "model_id": { "$ref": "#/$defs/id" }, "model_parameters": { "type": "object" }, "host_id": { "$ref": "#/$defs/id" }, "sandbox_profile_id": { "$ref": "#/$defs/id" }, "network_profile": { "type": "string" }, "allowed_paths": { "$ref": "#/$defs/strings" }, "gate_digest": { "$ref": "#/$defs/sha256" }, "publication_policy": { "const": "verified-integration-only" }, "created_at": { "type": "string" }, "assignment_digest": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false }
  }
}
