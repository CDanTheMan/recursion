{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursion.local/schemas/control-plane/v2/schema.json",
  "title": "Recursion execution fabric contracts v2",
  "description": "Strict declarative records. Validators reject unknown fields and secret material.",
  "oneOf": [
    { "$ref": "#/$defs/engine" }, { "$ref": "#/$defs/provider" },
    { "$ref": "#/$defs/capacity_pool" }, { "$ref": "#/$defs/model" },
    { "$ref": "#/$defs/host" }, { "$ref": "#/$defs/sandbox_profile" }, { "$ref": "#/$defs/execution_profile" },
    { "$ref": "#/$defs/routing_policy" }, { "$ref": "#/$defs/project" },
    { "$ref": "#/$defs/assignment" }, { "$ref": "#/$defs/registry" }
  ],
  "allOf": [
    { "if": { "properties": { "kind": { "const": "capacity_pool" } } }, "then": { "properties": { "fallback_policy": { "enum": ["defer", "approved", "allow-approved"] } } } },
    { "if": { "properties": { "kind": { "const": "routing_policy" } } }, "then": { "properties": { "fallback_policy": { "enum": ["defer", "approved", "allow-approved"] } } } },
    { "if": { "properties": { "kind": { "const": "routing_policy" }, "allow_metered": { "const": true } } }, "then": { "properties": { "fallback_policy": { "enum": ["approved", "allow-approved"] } } } }
    ,{ "if": { "properties": { "kind": { "const": "assignment" } } }, "then": { "properties": { "task_id": { "$ref": "#/$defs/id" } } } }
    ,{ "if": { "properties": { "kind": { "const": "routing_policy" }, "weights": { "type": "object" } }, "required": ["kind", "weights"] }, "then": { "properties": { "policy": { "const": "weighted-rotation" } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "engine" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/engine" } } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "provider" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/provider" } } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "capacity_pool" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/capacity_pool" } } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "model" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/model" } } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "host" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/host" } } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "sandbox_profile" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/sandbox_profile" } } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "execution_profile" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/execution_profile" } } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "routing_policy" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/routing_policy" } } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "project" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/project" } } } } }
    ,{ "if": { "required": ["registry"], "properties": { "registry": { "const": "assignment" } } }, "then": { "properties": { "entries": { "items": { "$ref": "#/$defs/assignment" } } } } }
    ,{ "$ref": "#/$defs/secret_free" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "role": { "enum": ["implementer", "verifier", "planner", "project-lead", "reviewer", "browser-qa"] },
    "execution_profile": { "type": "object", "required": ["schema_version", "kind", "id", "roles", "engine_ids", "provider_ids", "capacity_pool_ids", "model_ids", "host_ids", "sandbox_profile_ids", "network_profiles"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "execution_profile" }, "id": { "$ref": "#/$defs/id" }, "roles": { "$ref": "#/$defs/roles" }, "engine_ids": { "$ref": "#/$defs/refs" }, "provider_ids": { "$ref": "#/$defs/refs" }, "capacity_pool_ids": { "$ref": "#/$defs/refs" }, "model_ids": { "$ref": "#/$defs/refs" }, "host_ids": { "$ref": "#/$defs/refs" }, "sandbox_profile_ids": { "$ref": "#/$defs/refs" }, "network_profiles": { "$ref": "#/$defs/strings" } }, "additionalProperties": false },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/role" }, "minItems": 1, "uniqueItems": true },
    "refs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "routing_order": { "enum": ["billing_basis", "cost_class", "pool_id", "provider_id", "capacity_pool_id", "model_id", "engine_id", "host_id", "sandbox_profile_id", "speed_class", "reasoning_class", "manual_pin"] },
    "secret_free": { "anyOf": [ { "type": "string", "anyOf": [ { "pattern": "^secret:" }, { "not": { "pattern": "(?:[sS][kK]-[A-Za-z0-9_-]{12,}|[gG][hH][pP]_[A-Za-z0-9]{12,}|[gG][iI][tT][hH][uU][bB]_[pP][aA][tT]_[A-Za-z0-9_]{12,}|[xX][oO][xX][bBaApPrRsS]-[A-Za-z0-9-]{12,}|[aA][kK][iI][aA][0-9A-Za-z]{16}|[nN][pP][mM]_[A-Za-z0-9]{12,}|[aA][iI][zZ][aA][0-9A-Za-z_-]{20,}|[bB][eE][aA][rR][eE][rR][ \\t]+[^ \\t]+|(?:[aA][pP][iI][-_]?[kK][eE][yY]|[pP][aA][sS][sS][wW][oO][rR][dD]|[sS][eE][cC][rR][eE][tT])[ \\t]*[:=]|-----BEGIN [A-Z ]+ KEY-----)" } } ] }, { "type": "array", "items": { "$ref": "#/$defs/secret_free" } }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/secret_free" } }, { "type": ["number", "boolean", "null"] } ] },
    "base": {
      "type": "object", "required": ["schema_version", "kind", "id"],
      "properties": { "schema_version": { "const": 2 }, "kind": { "type": "string" }, "id": { "$ref": "#/$defs/id" } },
      "additionalProperties": false
    },
    "registry": {
      "type": "object", "required": ["schema_version", "registry", "entries"],
      "properties": {
        "schema_version": { "const": 2 },
        "registry": { "enum": ["engine", "provider", "capacity_pool", "model", "host", "sandbox_profile", "execution_profile", "routing_policy", "project", "assignment"] },
        "entries": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/engine" }, { "$ref": "#/$defs/provider" }, { "$ref": "#/$defs/capacity_pool" }, { "$ref": "#/$defs/model" }, { "$ref": "#/$defs/host" }, { "$ref": "#/$defs/sandbox_profile" }, { "$ref": "#/$defs/execution_profile" }, { "$ref": "#/$defs/routing_policy" }, { "$ref": "#/$defs/project" }, { "$ref": "#/$defs/assignment" }] } }
      }, "additionalProperties": false
    },
    "protocol": {
      "type": "object", "required": ["supported", "protocol"],
      "properties": { "supported": { "type": "boolean" }, "protocol": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "probe": {
      "type": "object", "required": ["type", "endpoint", "timeout_s"],
      "properties": { "type": { "enum": ["none", "http", "command"] }, "endpoint": { "type": "string", "minLength": 1 }, "timeout_s": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "quota": {
      "type": "object", "required": ["period", "source", "confidence"],
      "properties": { "period": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "minLength": 1 }, "remaining": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object", "required": ["protocol", "timeout_s"],
      "properties": { "protocol": { "type": "string", "minLength": 1 }, "timeout_s": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "model_parameters": {
      "type": "object", "properties": { "effort": { "type": "string", "minLength": 1 }, "context_tokens": { "type": "integer", "minimum": 1 }, "temperature": { "type": "number", "minimum": 0, "maximum": 2 }, "structured_output": { "type": "boolean" } }, "additionalProperties": false
    },
    "relative_path": { "type": "string", "pattern": "^(?!.*\\u0000)(?!\\s)(?!.*\\s$)(?![/\\\\]|[A-Za-z]:)(?!.*(?:^|[/\\\\])\\.{1,2}(?:[/\\\\]|$))[^/\\\\]+(?:[/\\\\][^/\\\\]+)*$" },
    "endpoint": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "engine": {
      "type": "object", "required": ["schema_version", "kind", "id", "description", "runtime_layout", "argv_template", "structured_output", "roles", "capabilities", "cancellation", "resume", "usage_receipt", "network_capabilities", "compatible_sandbox_profiles", "compatible_host_capabilities"],
      "properties": {
        "schema_version": { "const": 2 }, "kind": { "const": "engine" }, "id": { "$ref": "#/$defs/id" }, "description": { "type": "string", "minLength": 1 },
        "runtime_layout": { "type": "object", "required": ["kind", "executable", "runtime_paths", "read_only_mounts"], "properties": { "kind": { "enum": ["bare", "runtime-tree"] }, "executable": { "$ref": "#/$defs/relative_path" }, "runtime_paths": { "type": "array", "items": { "$ref": "#/$defs/relative_path" }, "uniqueItems": true }, "read_only_mounts": { "type": "array", "items": { "$ref": "#/$defs/relative_path" }, "uniqueItems": true } }, "additionalProperties": false },
        "argv_template": { "$ref": "#/$defs/strings" }, "structured_output": { "type": "boolean" }, "roles": { "$ref": "#/$defs/roles" }, "capabilities": { "$ref": "#/$defs/strings" }, "health_probe": { "anyOf": [{ "$ref": "#/$defs/probe" }, { "type": "null" }] }, "cancellation": { "$ref": "#/$defs/protocol" }, "resume": { "$ref": "#/$defs/protocol" }, "usage_receipt": { "$ref": "#/$defs/protocol" }, "network_capabilities": { "$ref": "#/$defs/strings" }, "compatible_sandbox_profiles": { "$ref": "#/$defs/refs" }, "compatible_host_capabilities": { "$ref": "#/$defs/strings" }, "enabled": { "type": "boolean" }
      }, "additionalProperties": false
    },
    "provider": { "type": "object", "required": ["schema_version", "kind", "id", "endpoints", "egress_profile", "receipt_semantics", "error_classes", "data_classification"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "provider" }, "id": { "$ref": "#/$defs/id" }, "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" }, "minItems": 1, "uniqueItems": true }, "egress_profile": { "type": "string", "minLength": 1 }, "receipt_semantics": { "type": "string", "minLength": 1 }, "error_classes": { "$ref": "#/$defs/strings" }, "data_classification": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "capacity_pool": { "type": "object", "required": ["schema_version", "kind", "id", "account_id", "billing_basis", "credential_ref", "roles", "quota", "on_demand", "initial_concurrency", "fallback_policy", "status"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "capacity_pool" }, "id": { "$ref": "#/$defs/id" }, "account_id": { "type": "string", "minLength": 1 }, "billing_basis": { "enum": ["included", "weekly-included", "metered", "local", "human"] }, "credential_ref": { "type": "string", "pattern": "^secret:[a-z][a-z0-9._/-]{1,127}$" }, "roles": { "$ref": "#/$defs/roles" }, "projects": { "$ref": "#/$defs/refs" }, "models": { "$ref": "#/$defs/refs" }, "hosts": { "$ref": "#/$defs/refs" }, "quota": { "$ref": "#/$defs/quota" }, "spend_ceiling_usd": { "type": "integer", "minimum": 0 }, "on_demand": { "type": "boolean" }, "initial_concurrency": { "type": "integer", "minimum": 1 }, "cooldown_s": { "type": "integer", "minimum": 0 }, "fallback_policy": { "type": "string", "minLength": 1 }, "status": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "model": { "type": "object", "required": ["schema_version", "kind", "id", "provider_ids", "engine_ids", "roles", "data_classes", "capabilities", "reasoning_class", "speed_class", "cost_class", "efforts", "context_tokens", "status"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "model" }, "id": { "$ref": "#/$defs/id" }, "provider_ids": { "$ref": "#/$defs/refs" }, "engine_ids": { "$ref": "#/$defs/refs" }, "roles": { "$ref": "#/$defs/roles" }, "data_classes": { "$ref": "#/$defs/strings" }, "capabilities": { "$ref": "#/$defs/strings" }, "reasoning_class": { "type": "string", "minLength": 1 }, "speed_class": { "type": "string", "minLength": 1 }, "cost_class": { "type": "string", "minLength": 1 }, "efforts": { "$ref": "#/$defs/strings" }, "context_tokens": { "type": "integer", "minimum": 1 }, "status": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "host": { "type": "object", "required": ["schema_version", "kind", "id", "class", "operating_system", "architecture", "cpu", "ram_mb", "disk_mb", "gpu", "gui", "engine_ids", "sandbox_profile_ids", "capabilities", "network_profiles", "network_endpoints", "concurrency", "heartbeat", "recovery", "trust_class", "status"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "host" }, "id": { "$ref": "#/$defs/id" }, "class": { "type": "string", "minLength": 1 }, "operating_system": { "type": "string", "minLength": 1 }, "architecture": { "type": "string", "minLength": 1 }, "cpu": { "type": "string", "minLength": 1 }, "ram_mb": { "type": "integer", "minimum": 1 }, "disk_mb": { "type": "integer", "minimum": 1 }, "gpu": { "type": "string", "minLength": 1 }, "gui": { "type": "boolean" }, "engine_ids": { "$ref": "#/$defs/refs" }, "sandbox_profile_ids": { "$ref": "#/$defs/refs" }, "capabilities": { "$ref": "#/$defs/strings" }, "network_profiles": { "$ref": "#/$defs/strings" }, "network_endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" }, "uniqueItems": true }, "concurrency": { "type": "integer", "minimum": 1 }, "heartbeat": { "$ref": "#/$defs/lifecycle" }, "recovery": { "$ref": "#/$defs/lifecycle" }, "trust_class": { "type": "string", "minLength": 1 }, "status": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "sandbox_profile": { "type": "object", "required": ["schema_version", "kind", "id", "isolation", "operating_system", "write_scope", "network_profiles", "network_endpoints", "capabilities", "trust_class", "controller_visibility"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "sandbox_profile" }, "id": { "$ref": "#/$defs/id" }, "isolation": { "type": "string", "minLength": 1 }, "operating_system": { "type": "string", "minLength": 1 }, "write_scope": { "type": "string", "minLength": 1 }, "network_profiles": { "$ref": "#/$defs/strings" }, "network_endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpoint" }, "uniqueItems": true }, "capabilities": { "$ref": "#/$defs/strings" }, "trust_class": { "type": "string", "minLength": 1 }, "controller_visibility": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "routing_policy": { "type": "object", "required": ["schema_version", "kind", "id", "policy", "role", "candidate_order", "allow_metered", "fallback_policy"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "routing_policy" }, "id": { "$ref": "#/$defs/id" }, "policy": { "enum": ["manual-pin", "subscription-first", "local-first", "cheapest-eligible", "fastest-eligible", "strongest-reviewer", "weighted-rotation", "no-metered-fallback"] }, "role": { "$ref": "#/$defs/role" }, "candidate_order": { "type": "array", "items": { "$ref": "#/$defs/routing_order" }, "minItems": 1, "uniqueItems": true }, "allow_metered": { "type": "boolean" }, "fallback_policy": { "enum": ["defer", "approved", "allow-approved"] }, "weights": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,63}$" }, "additionalProperties": { "type": "integer", "minimum": 1 } } }, "additionalProperties": false },
    "project": { "type": "object", "required": ["schema_version", "kind", "id", "repository", "default_branch", "integration_branch", "task_branch_pattern", "external_branch_patterns", "publication_policy", "source_policy", "allowed_paths", "gate_commands", "eligible_hosts", "eligible_pools", "status"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "project" }, "id": { "$ref": "#/$defs/id" }, "repository": { "type": "string", "minLength": 1 }, "default_branch": { "type": "string", "minLength": 1 }, "integration_branch": { "type": "string", "minLength": 1 }, "task_branch_pattern": { "type": "string", "minLength": 1 }, "external_branch_patterns": { "$ref": "#/$defs/strings" }, "publication_policy": { "const": "verified-integration-only" }, "source_policy": { "const": "exact-sha" }, "allowed_paths": { "type": "array", "items": { "$ref": "#/$defs/relative_path" }, "uniqueItems": true }, "gate_commands": { "$ref": "#/$defs/strings" }, "eligible_hosts": { "$ref": "#/$defs/refs" }, "eligible_pools": { "$ref": "#/$defs/refs" }, "status": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "assignment": { "type": "object", "required": ["schema_version", "kind", "id", "task_id", "project_id", "source_repository", "source_branch", "source_sha", "seed_manifest_digest", "engine_id", "provider_id", "capacity_pool_id", "model_id", "model_parameters", "host_id", "sandbox_profile_id", "network_profile", "allowed_paths", "gate_digest", "publication_policy", "created_at", "assignment_digest"], "properties": { "schema_version": { "const": 2 }, "kind": { "const": "assignment" }, "id": { "$ref": "#/$defs/id" }, "task_id": { "type": "string", "minLength": 1 }, "project_id": { "$ref": "#/$defs/id" }, "source_repository": { "type": "string", "minLength": 1 }, "source_branch": { "type": "string", "minLength": 1 }, "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }, "seed_manifest_digest": { "$ref": "#/$defs/sha256" }, "engine_id": { "$ref": "#/$defs/id" }, "provider_id": { "$ref": "#/$defs/id" }, "capacity_pool_id": { "$ref": "#/$defs/id" }, "model_id": { "$ref": "#/$defs/id" }, "model_parameters": { "$ref": "#/$defs/model_parameters" }, "host_id": { "$ref": "#/$defs/id" }, "sandbox_profile_id": { "$ref": "#/$defs/id" }, "network_profile": { "type": "string", "minLength": 1 }, "allowed_paths": { "type": "array", "items": { "$ref": "#/$defs/relative_path" }, "minItems": 1, "uniqueItems": true }, "gate_digest": { "$ref": "#/$defs/sha256" }, "publication_policy": { "const": "verified-integration-only" }, "created_at": { "type": "string", "minLength": 1 }, "assignment_digest": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false }
  }
}
