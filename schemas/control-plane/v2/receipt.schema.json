{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://recursion.local/schemas/control-plane/v2/receipt.schema.json","title":"Recursion v2 receipt contract","type":"object","additionalProperties":false,"required":["schema_version","kind","id","task_id","task_digest","assignment_digest","adapter","candidate_id","candidate_commit","result_digest","status","usage","checkpoint_digests","started_at","finished_at","receipt_digest"],"properties":{"schema_version":{"const":2},"kind":{"const":"receipt"},"id":{"$ref":"#/$defs/id"},"task_id":{"$ref":"#/$defs/id"},"task_digest":{"$ref":"#/$defs/digest"},"assignment_digest":{"$ref":"#/$defs/digest"},"adapter":{"$ref":"#/$defs/safe"},"candidate_id":{"$ref":"#/$defs/id"},"candidate_commit":{"$ref":"#/$defs/sha"},"result_digest":{"$ref":"#/$defs/digest"},"status":{"enum":["queued","running","succeeded","failed","cancelled","expired","rejected"]},"usage":{"$ref":"#/$defs/usage"},"checkpoint_digests":{"$ref":"#/$defs/digests"},"started_at":{"$ref":"#/$defs/time"},"finished_at":{"$ref":"#/$defs/time"},"receipt_digest":{"$ref":"#/$defs/digest"}},"$defs":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,63}$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"safe":{"type":"string","minLength":1,"maxLength":65536,"not":{"pattern":"(?:sk-[A-Za-z0-9_-]{12,}|gh[pousr]_[A-Za-z0-9_-]{12,}|github_pat_[A-Za-z0-9_]{12,}|xox[baprs]-[A-Za-z0-9-]{12,}|AKIA[0-9A-Z]{16}|npm_[A-Za-z0-9]{12,}|AIza[0-9A-Za-z_-]{20,}|bearer[ \\t]+[^ \\t]+|(?:api[_-]?key|password|secret|token)[ \\t]*[:=]|-----BEGIN [A-Z ]+ KEY-----)"}},"time":{"type":"string","format":"date-time","pattern":"^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"},"nonnegative":{"type":"integer","minimum":0},"positive":{"type":"integer","minimum":1},"strings":{"type":"array","minItems":1,"maxItems":1000,"uniqueItems":true,"items":{"$ref":"#/$defs/safe"}},"paths":{"type":"array","min