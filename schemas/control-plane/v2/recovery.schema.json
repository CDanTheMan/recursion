{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://recursion.local/schemas/control-plane/v2/recovery.schema.json","title":"Recursion v2 recovery contract","type":"object","additionalProperties":false,"required":["schema_version","kind","id","task_id","task_digest","prior_checkpoint_digest","prior_receipt_digest","action","state","failure_class","attempt","created_at","outcome","recovery_digest"],"properties":{"schema_version":{"const":2},"kind":{"const":"recovery"},"id":{"$ref":"#/$defs/id"},"task_id":{"$ref":"#/$defs/id"},"task_digest":{"$ref":"#/$defs/digest"},"prior_checkpoint_digest":{"$ref":"#/$defs/digest"},"prior_receipt_digest":{"$ref":"#/$defs/digest"},"action":{"enum":["resume","retry","abort","pause","reconcile"]},"state":{"enum":["queued","running","paused","succeeded","failed","terminal"]},"failure_class":{"enum":["none","timeout","host-loss","provider-unavailable","quota-exhausted","invalid-result","authorization","unknown"]},"attempt":{"$ref":"#/$defs/positive"},"created_at":{"$ref":"#/$defs/time"},"outcome":{"enum":["requeued","resumed","aborted","paused","completed","failed"]},"recovery_digest":{"$ref":"#/$defs/digest"}},"$defs":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,63}$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"safe":{"type":"string","minLength":1,"maxLength":65536,"not":{"pattern":"(?:sk-[A-Za-z0-9_-]{12,}|gh[pousr]_[A-Za-z0-9_-]{12,}|github_pat_[A-Za-z0-9_]{12,}|xox[baprs]-[A-Za-z0-9-]{12,}|AKIA[0-9A-Z]{16}|npm_[A-Za-z0-9]{12,}|AIza[0-9A-Za-z_-]{20,}|bearer[ \\t]+[^ \\t]+|(?:api[_-]?key|password|secret|token)[ \\t]*[:=]|-----BEGIN [A-Z ]+ KEY-----)"}},"time":{"type":"string","pattern":"^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"},"nonnegative":{"type":"integer","minimum":0},"positive":{"type":"integer","minimum":1},"strings":{"type":"array","minItems":1,"maxItems":1000,"uniqueItems":true,"items":{"$ref":"#/$defs/safe"}},"paths":{"type":"arra