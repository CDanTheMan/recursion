{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recursion.invalid/schemas/control-plane/v1/execution-fabric.schema.json",
  "title": "Recursion v2 execution fabric records",
  "description": "Strict, inert control-plane records for host placement and remote reconciliation.",
  "oneOf": [
    { "$ref": "#/$defs/host_registration" },
    { "$ref": "#/$defs/host_heartbeat" },
    { "$ref": "#/$defs/pool_status" },
    { "$ref": "#/$defs/placement_requirements" },
    { "$ref": "#/$defs/placement_candidate" },
    { "$ref": "#/$defs/assignment" },
    { "$ref": "#/$defs/placement_rejection" },
    { "$ref": "#/$defs/lease_event" },
    { "$ref": "#/$defs/lease_status_event" },
    { "$ref": "#/$defs/result_event" },
    { "$ref": "#/$defs/verification_receipt" },
    { "$ref": "#/$defs/routing_policy" },
    { "$ref": "#/$defs/integration_policy_event" },
    { "$ref": "#/$defs/integration_admit_event" },
    { "$ref": "#/$defs/integration_complete_event" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "host_registration": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "host_id", "capabilities", "operating_system", "architectures", "sandbox_profiles", "network_profiles", "trust_class", "max_concurrency", "workload_concurrency", "registration_digest", "registered_at", "network_endpoints"],
      "properties": {
        "schema_version": { "const": 1 }, "kind": { "const": "host_registration" }, "host_id": { "$ref": "#/$defs/id" },
        "capabilities": { "$ref": "#/$defs/strings" }, "operating_system": { "type": "string", "minLength": 1 },
        "architectures": { "$ref": "#/$defs/strings" }, "sandbox_profiles": { "$ref": "#/$defs/strings" },
        "network_profiles": { "$ref": "#/$defs/strings" }, "trust_class": { "type": "string", "minLength": 1 },
        "max_concurrency": { "type": "integer", "minimum": 0 },
        "workload_concurrency": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "registration_digest": { "$ref": "#/$defs/digest" }, "registered_at": { "$ref": "#/$defs/timestamp" },
        "network_endpoints": { "type": "object", "additionalProperties": { "$ref": "#/$defs/strings" } }
      }
    },
    "host_heartbeat": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "host_id", "registration_digest", "sequence", "observed_at", "lease_epoch"],
      "properties": {
        "schema_version": { "const": 1 }, "kind": { "const": "host_heartbeat" }, "host_id": { "$ref": "#/$defs/id" },
        "registration_digest": { "$ref": "#/$defs/digest" }, "sequence": { "type": "integer", "minimum": 0 },
        "observed_at": { "$ref": "#/$defs/timestamp" }, "lease_epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "pool_status": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "pool_id", "billing_basis", "allowed_roles", "allowed_projects", "allowed_models", "max_concurrency", "in_flight", "quota_remaining", "quota_period", "on_demand", "cost_per_run"],
      "properties": {
        "schema_version": { "const": 1 }, "kind": { "const": "pool_status" }, "pool_id": { "$ref": "#/$defs/id" }, "account_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "billing_basis": { "type": "string", "minLength": 1 }, "allowed_roles": { "$ref": "#/$defs/strings" },
        "allowed_projects": { "$ref": "#/$defs/strings" }, "allowed_models": { "$ref": "#/$defs/strings" },
        "max_concurrency": { "type": "integer", "minimum": 0 }, "in_flight": { "type": "integer", "minimum": 0 },
        "quota_remaining": { "type": ["integer", "null"], "minimum": 0 }, "quota_period": { "type": ["string", "null"] },
        "on_demand": { "type": "boolean" }, "cost_per_run": { "type": "number", "minimum": 0 },
        "account_quota_remaining": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "placement_requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "task_id", "project_id", "role", "capabilities", "operating_system", "sandbox_profile", "network_profile", "billing_basis", "max_cost_usd", "model", "preferred_hosts", "preferred_pools", "source_sha"],
      "properties": {
        "schema_version": { "const": 1 }, "kind": { "const": "placement_requirements" }, "task_id": { "$ref": "#/$defs/id" },
        "project_id": { "$ref": "#/$defs/id" }, "role": { "type": "string", "minLength": 1 }, "capabilities": { "$ref": "#/$defs/strings" },
        "operating_system": { "type": ["string", "null"] }, "sandbox_profile": { "type": ["string", "null"] },
        "network_profile": { "type": ["string", "null"] }, "billing_basis": { "$ref": "#/$defs/strings" },
        "max_cost_usd": { "type": "number", "minimum": 0 }, "model": { "type": ["string", "null"] },
        "preferred_hosts": { "$ref": "#/$defs/strings" }, "preferred_pools": { "$ref": "#/$defs/strings" }, "source_sha": { "$ref": "#/$defs/sha" }, "policy": { "type": "string", "enum": ["manual-pin", "subscription-first", "local-first", "cheapest-eligible", "fastest-eligible", "strongest-reviewer", "weighted-rotation"] }, "manual_candidate_id": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "source_repository": { "type": "string", "minLength": 1 }, "source_branch": { "type": "string", "minLength": 1 }, "seed_manifest_digest": { "$ref": "#/$defs/digest" }, "model_parameters": { "type": "object" }, "allowed_paths": { "$ref": "#/$defs/strings" }, "gate_digest": { "$ref": "#/$defs/digest" }, "publication_policy": { "type": "string", "minLength": 1 }
      }
    },
    "placement_candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "candidate_id", "engine", "provider", "pool_id", "model", "host_id", "sandbox_profile", "network_profile", "capabilities", "operating_system", "billing_basis", "cost_per_run", "roles", "enabled"],
      "properties": {
        "schema_version": { "const": 1 }, "kind": { "const": "placement_candidate" }, "candidate_id": { "$ref": "#/$defs/id" },
        "engine": { "$ref": "#/$defs/id" }, "provider": { "$ref": "#/$defs/id" }, "pool_id": { "$ref": "#/$defs/id" },
        "model": { "type": "string", "minLength": 1 }, "host_id": { "$ref": "#/$defs/id" }, "sandbox_profile": { "type": "string", "minLength": 1 },
        "network_profile": { "type": "string", "minLength": 1 }, "capabilities": { "$ref": "#/$defs/strings" },
        "operating_system": { "type": "string", "minLength": 1 }, "billing_basis": { "type": "string", "minLength": 1 },
        "cost_per_run": { "type": "number", "minimum": 0 }, "roles": { "$ref": "#/$defs/strings" }, "enabled": { "type": "boolean" }, "speed_score": { "type": "number", "minimum": 0 }, "reviewer_score": { "type": "number", "minimum": 0 }, "weight": { "type": "integer", "minimum": 1 }, "required_endpoints": { "$ref": "#/$defs/strings" }
      }
    },
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "task_id", "project_id", "source_sha", "engine", "provider", "capacity_pool", "model", "host", "sandbox_profile", "network_profile", "assignment_digest", "created_at", "account_id", "role", "source_repository", "source_branch", "seed_manifest_digest", "model_parameters", "allowed_paths", "gate_digest", "publication_policy", "candidate_id"],
      "properties": {
        "schema_version": { "const": 1 }, "kind": { "const": "assignment" }, "task_id": { "$ref": "#/$defs/id" }, "project_id": { "$ref": "#/$defs/id" },
        "source_sha": { "$ref": "#/$defs/sha" }, "engine": { "$ref": "#/$defs/id" }, "provider": { "$ref": "#/$defs/id" }, "capacity_pool": { "$ref": "#/$defs/id" }, "account_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "role": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }, "host": { "$ref": "#/$defs/id" }, "sandbox_profile": { "type": "string", "minLength": 1 }, "network_profile": { "type": "string", "minLength": 1 },
        "assignment_digest": { "$ref": "#/$defs/digest" }, "created_at": { "$ref": "#/$defs/timestamp" },
        "source_repository": { "type": "string", "minLength": 1 }, "source_branch": { "type": "string", "minLength": 1 }, "seed_manifest_digest": { "$ref": "#/$defs/digest" }, "model_parameters": { "type": "object" }, "allowed_paths": { "$ref": "#/$defs/strings" }, "gate_digest": { "$ref": "#/$defs/digest" }, "publication_policy": { "type": "string", "minLength": 1 }, "candidate_id": { "$ref": "#/$defs/id" }
      }
    },
    "placement_rejection": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "candidate_id", "code", "reason"],
      "properties": { "schema_version": { "const": 1 }, "kind": { "const": "placement_rejection" }, "candidate_id": { "$ref": "#/$defs/id" }, "code": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }
    },
    "event_common": {
      "type": "object", "required": ["event", "schema_version", "event_digest", "prev_event_digest"],
      "properties": { "event": { "type": "string" }, "schema_version": { "const": 1 }, "event_digest": { "$ref": "#/$defs/digest" }, "prev_event_digest": { "$ref": "#/$defs/digest" } }
    },
    "lease_event": {
      "allOf": [
        { "$ref": "#/$defs/event_common" },
        { "type": "object", "additionalProperties": false,
          "required": ["event", "schema_version", "event_digest", "prev_event_digest", "lease_id", "attempt_id", "remote_session_id", "assignment_digest", "assignment", "status", "created_at", "updated_at", "expires_at", "reservation", "recovery_state"],
          "properties": { "event": { "const": "lease" }, "schema_version": { "const": 1 }, "event_digest": { "$ref": "#/$defs/digest" }, "prev_event_digest": { "$ref": "#/$defs/digest" }, "lease_id": { "$ref": "#/$defs/id" }, "attempt_id": { "$ref": "#/$defs/id" }, "remote_session_id": { "$ref": "#/$defs/id" }, "assignment_digest": { "$ref": "#/$defs/digest" }, "assignment": { "$ref": "#/$defs/assignment" }, "status": { "const": "active" }, "created_at": { "$ref": "#/$defs/timestamp" }, "updated_at": { "$ref": "#/$defs/timestamp" }, "expires_at": { "$ref": "#/$defs/timestamp" }, "reservation": { "type": "object", "additionalProperties": false, "required": ["host", "pool", "role"], "properties": { "host": { "$ref": "#/$defs/id" }, "pool": { "$ref": "#/$defs/id" }, "role": { "type": "string", "minLength": 1 } } }, "recovery_state": { "const": "none" } }
        }
      ]
    },
    "lease_status_event": {
      "allOf": [
        { "$ref": "#/$defs/event_common" },
        { "type": "object", "additionalProperties": false,
          "required": ["event", "schema_version", "event_digest", "prev_event_digest", "lease_id", "status", "updated_at", "observed_at", "recovery_state"],
          "properties": { "event": { "const": "lease_status" }, "schema_version": { "const": 1 }, "event_digest": { "$ref": "#/$defs/digest" }, "prev_event_digest": { "$ref": "#/$defs/digest" }, "lease_id": { "$ref": "#/$defs/id" }, "status": { "enum": ["recovery_required", "expired", "succeeded", "failed", "cancelled"] }, "updated_at": { "$ref": "#/$defs/timestamp" }, "observed_at": { "$ref": "#/$defs/timestamp" }, "recovery_state": { "enum": ["query_pending", "query_running", "query_unknown", "query_terminal", "none"] } }
        }
      ]
    },
    "result_event": {
      "allOf": [
        { "$ref": "#/$defs/event_common" },
        { "type": "object", "additionalProperties": false,
          "required": ["event", "schema_version", "event_digest", "prev_event_digest", "attempt_id", "lease_id", "assignment_digest", "result_digest", "status", "observed_at"],
          "properties": { "event": { "const": "result" }, "schema_version": { "const": 1 }, "event_digest": { "$ref": "#/$defs/digest" }, "prev_event_digest": { "$ref": "#/$defs/digest" }, "attempt_id": { "$ref": "#/$defs/id" }, "lease_id": { "$ref": "#/$defs/id" }, "assignment_digest": { "$ref": "#/$defs/digest" }, "result_digest": { "$ref": "#/$defs/digest" }, "status": { "enum": ["succeeded", "failed", "cancelled"] }, "observed_at": { "$ref": "#/$defs/timestamp" } }
        }
      ]
    },
    "verification_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "receipt_id", "assignment_digest", "source_sha", "candidate_id", "result_commit", "diff_digest", "scope_digest", "gate_digest", "verifier_identity", "verified_at", "verification_status", "receipt_digest"],
      "properties": {
        "schema_version": { "const": 1 }, "kind": { "const": "verification_receipt" }, "receipt_id": { "$ref": "#/$defs/id" },
        "assignment_digest": { "$ref": "#/$defs/digest" }, "source_sha": { "$ref": "#/$defs/sha" }, "candidate_id": { "$ref": "#/$defs/id" }, "result_commit": { "$ref": "#/$defs/sha" },
        "diff_digest": { "$ref": "#/$defs/digest" }, "scope_digest": { "$ref": "#/$defs/digest" }, "gate_digest": { "$ref": "#/$defs/digest" }, "verifier_identity": { "type": "string", "pattern": "^controller/.+" }, "verified_at": { "$ref": "#/$defs/timestamp" }, "verification_status": { "const": "pass" }, "receipt_digest": { "$ref": "#/$defs/digest" }, "authentication_tag": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "routing_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "policy_id", "allowed_billing_basis", "allow_on_demand", "authority", "policy_digest"],
      "properties": {
        "schema_version": { "const": 1 }, "kind": { "const": "routing_policy" }, "policy_id": { "$ref": "#/$defs/id" }, "allowed_billing_basis": { "$ref": "#/$defs/strings" }, "allow_on_demand": { "type": "boolean" }, "authority": { "type": "string", "minLength": 1 }, "policy_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "integration_policy_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event", "schema_version", "event_digest", "prev_event_digest", "project_id", "default_branch", "integration_branch"],
      "properties": {
        "event": { "const": "policy" }, "schema_version": { "const": 1 }, "event_digest": { "$ref": "#/$defs/digest" }, "prev_event_digest": { "$ref": "#/$defs/digest" }, "project_id": { "$ref": "#/$defs/id" }, "default_branch": { "type": "string", "minLength": 1 }, "integration_branch": { "type": "string", "minLength": 1 }
      }
    },
    "integration_admit_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event", "schema_version", "event_digest", "prev_event_digest", "candidate_id", "project_id", "assignment_digest", "source_sha", "result_commit", "source_ref", "result_ref", "default_branch", "integration_branch", "classification", "receipt_digest"],
      "properties": {
        "event": { "const": "admit" }, "schema_version": { "const": 1 }, "event_digest": { "$ref": "#/$defs/digest" }, "prev_event_digest": { "$ref": "#/$defs/digest" }, "candidate_id": { "$ref": "#/$defs/id" }, "project_id": { "$ref": "#/$defs/id" }, "assignment_digest": { "$ref": "#/$defs/digest" }, "source_sha": { "$ref": "#/$defs/sha" }, "result_commit": { "$ref": "#/$defs/sha" }, "source_ref": { "type": "string", "minLength": 1 }, "result_ref": { "type": "string", "minLength": 1 }, "default_branch": { "type": "string", "minLength": 1 }, "integration_branch": { "type": "string", "minLength": 1 }, "classification": { "enum": ["current-compatible", "stale-reviewable"] }, "receipt_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "integration_complete_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event", "schema_version", "event_digest", "prev_event_digest", "candidate_id"],
      "properties": {
        "event": { "const": "complete" }, "schema_version": { "const": 1 }, "event_digest": { "$ref": "#/$defs/digest" }, "prev_event_digest": { "$ref": "#/$defs/digest" }, "candidate_id": { "$ref": "#/$defs/id" }
      }
    }
  }
}
