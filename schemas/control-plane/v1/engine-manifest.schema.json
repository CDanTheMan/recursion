{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://recursion.local/schemas/control-plane/v1/engine-manifest.schema.json",
  "title": "Recursion engine plugin manifest v1",
  "description": "Documentation/box-tooling schema for scripts/engines/<name>.json. The authoritative, self-contained validation lives in scripts/resolve-engine.py (no jsonschema dependency at runtime); this schema exists to document the contract accurately and to support editor/CI tooling. See docs/plans/engine-plugin-architecture.md Component 1.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "description",
    "executable",
    "argv",
    "model",
    "roles",
    "billing",
    "network",
    "availability_probe",
    "concurrency_cap",
    "env_passthrough"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Must equal the manifest filename stem (e.g. gemini.json -> \"gemini\"), and must not collide with a builtin engine name (claude, hermes, gate, none, deepseek, openrouter)."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "executable": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Basename only (no path separators). Resolved via `command -v` inside the sandbox controller, then bind-mounted read-only exactly like the existing single-executable path. Need not equal `name`."
    },
    "argv": {
      "type": "array",
      "minItems": 2,
      "items": [
        {
          "const": "{{EXE}}",
          "description": "argv[0] must be the literal placeholder {{EXE}}."
        }
      ],
      "additionalItems": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "{{PROMPT}}"
      },
      "description": "Exactly one element must be the literal placeholder {{PROMPT}} (the count is enforced by the resolver; draft-07 `contains` only guarantees at least one). Any element that is wholly of the form {{...}} must be one of the three known placeholders ({{EXE}}, {{PROMPT}}, {{MODEL}}); {{EXE}} may appear only at index 0; {{MODEL}} may appear at most once anywhere in argv. No other templating is permitted."
    },
    "model": {
      "type": "object",
      "required": ["required", "argv_suffix"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean",
          "description": "If true, launch without a resolved model is refused."
        },
        "argv_suffix": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Appended to argv only when a model is present. Each element is either a plain literal string or the placeholder {{MODEL}}; {{MODEL}} may appear at most once."
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "enum": ["implementer", "verifier"]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "description": "Nonempty subset of {implementer, verifier} without duplicates."
    },
    "billing": {
      "type": "object",
      "required": ["basis", "provider"],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": ["flat-subscription", "metered", "local"],
          "description": "metered engines are admitted only under RECURSION_ALLOW_METERED=1 (same rule as engine=hermes today)."
        },
        "provider": {
          "type": "string",
          "enum": [
            "anthropic-claude-code",
            "cursor",
            "google-gemini",
            "openrouter-via-opencode",
            "sentry-local"
          ],
          "description": "Reviewed provider identity; new providers require a profile and an explicit schema/runtime allowlist update."
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["policy", "profile", "endpoints"],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": ["provider-only", "none"]
        },
        "profile": {
          "type": "string",
          "enum": ["anthropic", "cursor", "gemini", "openrouter", "sentry-local"]
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          },
          "uniqueItems": true,
          "description": "Documentation and deployment input for the provider-only allowlist enforced by the root-owned provider netns/proxy on the box. Empty list allowed (e.g. tunnel-local engines)."
        }
      }
    },
    "availability_probe": {
      "description": "null, or an HTTP probe spec. The URL itself lives in human-owned env, never in the manifest.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["type", "url_env", "timeout_s"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "http"
            },
            "url_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        }
      ]
    },
    "concurrency_cap": {
      "description": "null, or a positive integer maximum of simultaneous runs for this engine across the box.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "env_passthrough": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ANTHROPIC_API_KEY",
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
          "GEMINI_API_KEY",
          "OPENROUTER_API_KEY"
        ]
      },
      "uniqueItems": true,
      "description": "Env var names (not values) copied from the controller environment into the unit when set. The runtime resolver additionally requires each name to be in the exact reviewed allowlist of network.profile; the union here is only the public-schema vocabulary. Possibly empty. No duplicates."
    },
    "runtime_layout": {
      "description": "Optional v1-compatible runtime layout. sibling-tree stages the executable's complete parent directory read-only; executable-only preserves the original single-file behavior.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["executable-only", "sibling-tree"] },
            "source": { "const": "executable-directory" },
            "root": { "const": "executable-directory" },
            "target": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$" },
            "entrypoint": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$" }
          },
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "sibling-tree" } } },
              "then": { "required": ["source", "target", "entrypoint"] }
            },
            {
              "if": { "properties": { "mode": { "const": "executable-only" } } },
              "then": { "not": { "anyOf": [
                { "required": ["source"] }, { "required": ["root"] },
                { "required": ["target"] }, { "required": ["entrypoint"] }
              ] } }
            }
          ]
        }
      ]
    },
    "execution": {
      "type": "object",
      "required": ["structured_output", "output_format", "cancellation", "exit_codes"],
      "additionalProperties": false,
      "properties": {
        "structured_output": { "type": "boolean" },
        "output_format": { "enum": ["text", "json"] },
        "cancellation": {
          "type": "object", "required": ["signal", "grace_s"], "additionalProperties": false,
          "properties": { "signal": { "enum": ["TERM", "INT"] }, "grace_s": { "type": "integer", "minimum": 1, "maximum": 60 } }
        },
        "exit_codes": {
          "type": "object", "required": ["success", "auth", "runtime", "egress"], "additionalProperties": false,
          "properties": {
            "success": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 1 },
            "auth": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 1 },
            "runtime": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 1 },
            "egress": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 1 }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["mode", "required", "marker"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["none", "runner-home-marker"] },
        "required": { "type": "boolean" },
        "marker": { "type": ["string", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"network": {"properties": {"profile": {"const": "anthropic"}}}}},
      "then": {"properties": {
        "billing": {"properties": {"provider": {"const": "anthropic-claude-code"}}},
        "env_passthrough": {"items": {"enum": [
          "ANTHROPIC_API_KEY", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"
        ]}}
      }}
    },
    {
      "if": {"properties": {"network": {"properties": {"profile": {"const": "cursor"}}}}},
      "then": {"properties": {
        "billing": {"properties": {"provider": {"const": "cursor"}}},
        "env_passthrough": {"maxItems": 0}
      }}
    },
    {
      "if": {"properties": {"network": {"properties": {"profile": {"const": "gemini"}}}}},
      "then": {"properties": {
        "billing": {"properties": {"provider": {"const": "google-gemini"}}},
        "env_passthrough": {"items": {"enum": ["GEMINI_API_KEY"]}
      }}}
    },
    {
      "if": {"properties": {"network": {"properties": {"profile": {"const": "openrouter"}}}}},
      "then": {"properties": {
        "billing": {"properties": {"provider": {"const": "openrouter-via-opencode"}}},
        "env_passthrough": {"items": {"enum": ["OPENROUTER_API_KEY"]}
      }}}
    },
    {
      "if": {"properties": {"network": {"properties": {"profile": {"const": "sentry-local"}}}}},
      "then": {"properties": {
        "billing": {"properties": {"basis": {"const": "local"}, "provider": {"const": "sentry-local"}}},
        "env_passthrough": {"maxItems": 0},
        "network": {
          "properties": {"policy": {"const": "none"}, "endpoints": {"maxItems": 0}}
        }
      }}
    },
    {
      "if": {"properties": {"network": {"properties": {"policy": {"const": "provider-only"}}}}},
      "then": {"properties": {"network": {"properties": {"endpoints": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"network": {"properties": {"policy": {"const": "none"}}}}},
      "then": {"properties": {
        "billing": {"properties": {"basis": {"const": "local"}, "provider": {"const": "sentry-local"}}},
        "network": {"properties": {
          "profile": {"const": "sentry-local"}, "endpoints": {"maxItems": 0}
        }}
      }}
    }
  ]
}
