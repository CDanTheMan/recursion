  "metric_orientation": {
    "burden_difference": "adapted minus static; lower is favorable",
    "quality_difference": "adapted minus static; higher is favorable"
  },
  "rules": {
    "precedence": [
      "valid hard-floor failure -> stop/quarantine",
      "missing authorization/adopted decision inputs -> blocked",
      "invalid identification/counter coverage/analysis -> inconclusive or not identifiable",
      "absolute ceiling/floor or mature statistical regression -> reverse",
      "required quality/protected burden noninferiority and registered practical superiority -> eligible for independent promotion review",
      "registered equivalence or exclusion of necessary benefit -> scoped no-benefit",
      "otherwise -> no established benefit/inconclusive; keep static"
    ],
    "quality_noninferiority": "lower_bound(D_quality) > -delta_quality; equality is inconclusive",
    "protected_burden_noninferiority": "upper_bound(D_burden_k) < delta_burden_k for every protected metric; equality inconclusive",
    "practical_benefit": "upper_bound(D_primary_burden) < -benefit_primary plus all required gates and no unauthorized tradeoff",
    "excluded_required_benefit": "lower_bound(D_primary_burden) > -benefit_primary; excludes required magnitude, not necessarily equality",
    "equivalence": "entire registered valid interval strictly inside the adopted practical equivalence band",
    "burden_regression": "lower_bound(D_burden_k) > reversal_k OR absolute ceiling violation",
    "quality_regression": "upper_bound(D_quality_k) < -reversal_quality_k OR required absolute quality floor violation",
    "critical_safety": "any independently witnessed critical authority/privacy/canonical/effect failure stops; reward/statistical margins cannot compensate",
    "D024": "verified productive-continuity outcome and human-effort superiority required for headline; cheaper tokens at quality noninferiority alone insufficient"
  },
