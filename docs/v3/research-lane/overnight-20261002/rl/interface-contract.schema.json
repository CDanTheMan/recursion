{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:recursion:research:r-l:interface-contract:candidate-0",
  "title": "R-L application interface shape candidate",
  "description": "Review artifact, not accepted production protocol, not full semantic/authority validation, and not a changed M1B wire profile. No generated implementation or runtime test has run. Operation-specific schemas, bounds, identity resolution and semantic oracle remain mandatory.",
  "oneOf": [
    {
      "$ref": "#/$defs/Command"
    },
    {
      "$ref": "#/$defs/Query"
    },
    {
      "$ref": "#/$defs/Error"
    },
    {
      "$ref": "#/$defs/Status"
    },
    {
      "$ref": "#/$defs/Receipt"
    },
    {
      "$ref": "#/$defs/Negotiation"
    },
    {
      "$ref": "#/$defs/Interaction"
    },
    {
      "$ref": "#/$defs/Config"
    },
    {
      "$ref": "#/$defs/Snapshot"
    }
  ],
  "$defs": {
    "OpaqueRef": {
      "type": "string",
      "minLength": 1,
      "description": "Reference, not a credential/token or grant; resolved and authenticated by the appropriate service. Syntax remains candidate."
    },
    "RevisionRef": {
      "type": "string",
      "minLength": 1,
      "description": "Typed-domain revision identity; no production epoch representation selected."
    },
    "Digest": {
      "type": "string",
      "minLength": 1,
      "description": "Full algorithm-tagged digest; semantic canonicalization and dependency inputs defined by the versioned catalog."
    },
    "Error": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "typed-error"
        },
        "candidate_version": {
          "const": "r-l-candidate/0"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "failed_precondition": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "expected_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_attempted": {
          "enum": [
            "no",
            "yes",
            "unknown"
          ]
        },
        "retryability": {
          "enum": [
            "never",
            "same-id",
            "after-refresh",
            "reconcile"
          ]
        },
        "receipt_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpaqueRef"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "candidate_version",
        "code",
        "failed_precondition",
        "target",
        "expected_revision",
        "current_revision",
        "effect_attempted",
        "retryability",
        "receipt_refs",
        "explanation"
      ],
      "additionalProperties": false
    },
    "Target": {
      "type": "object",
      "properties": {
        "goal": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "goal",
        "task",
        "session",
        "attempt",
        "turn"
      ],
      "additionalProperties": false
    },
    "ExpectedRevisions": {
      "type": "object",
      "properties": {
        "object": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "process": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "daemon": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "object",
        "authority",
        "pause",
        "configuration",
        "route",
        "process",
        "daemon"
      ],
      "additionalProperties": false
    },
    "Command": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "command-intent"
        },
        "candidate_version": {
          "const": "r-l-candidate/0"
        },
        "command_id": {
          "$ref": "#/$defs/OpaqueRef",
          "description": "Canonical operation ID in admitted authority_domain. Principal-local client IDs require an explicit injective durable mapping before this record. Principal/grant remain immutable digest-bound semantics, not an implicit extra canonical namespace."
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "operation_version": {
          "type": "string",
          "minLength": 1
        },
        "argument_schema_digest": {
          "$ref": "#/$defs/Digest"
        },
        "arguments": {
          "type": "object"
        },
        "semantic_digest": {
          "$ref": "#/$defs/Digest",
          "description": "Immutable semantic content digest including principal/grant binding; used as equality/conflict check under (authority_domain, command_id), not as permission to create another operation with the same key."
        },
        "authority_domain": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "principal": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "grant_ref": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "expected_revisions": {
          "$ref": "#/$defs/ExpectedRevisions"
        },
        "causation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpaqueRef"
          }
        },
        "correlation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery_policy": {
          "type": "string",
          "minLength": 1
        },
        "deadline_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "reservation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "client_component_ref": {
          "$ref": "#/$defs/OpaqueRef"
        }
      },
      "required": [
        "kind",
        "candidate_version",
        "command_id",
        "operation",
        "operation_version",
        "argument_schema_digest",
        "arguments",
        "semantic_digest",
        "authority_domain",
        "principal",
        "grant_ref",
        "target",
        "expected_revisions",
        "causation_refs",
        "correlation_ref",
        "delivery_policy",
        "deadline_ref",
        "reservation_ref",
        "client_component_ref"
      ],
      "additionalProperties": false,
      "description": "Operation-specific argument schema and semantic validator must further close/validate arguments. This generic envelope is not authority, executable admission, or an M1B addition."
    },
    "KnownObservation": {
      "type": "object",
      "properties": {
        "knowledge": {
          "const": "known"
        },
        "value": {},
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "knowledge",
        "value",
        "reason",
        "source_ref",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "UnknownObservation": {
      "type": "object",
      "properties": {
        "knowledge": {
          "enum": [
            "unknown",
            "unavailable",
            "stale"
          ]
        },
        "value": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "knowledge",
        "value",
        "reason",
        "source_ref",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "Observation": {
      "oneOf": [
        {
          "$ref": "#/$defs/KnownObservation"
        },
        {
          "$ref": "#/$defs/UnknownObservation"
        }
      ],
      "description": "Known zero distinct from unknown. A stale prior value may be retained separately as evidence, never in the current value slot."
    },
    "Query": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "query-request"
        },
        "candidate_version": {
          "const": "r-l-candidate/0"
        },
        "projection_id": {
          "type": "string",
          "minLength": 1
        },
        "projection_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_digest": {
          "$ref": "#/$defs/Digest"
        },
        "scope_ref": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "filter": {
          "type": "object"
        },
        "audience_ref": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "source_cut": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit cut or latest; actual returned cut always required."
        },
        "consistency": {
          "enum": [
            "snapshot",
            "at-least-cut"
          ]
        },
        "deadline_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "continuation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "candidate_version",
        "projection_id",
        "projection_version",
        "schema_digest",
        "scope_ref",
        "filter",
        "audience_ref",
        "source_cut",
        "consistency",
        "deadline_ref",
        "max_items",
        "max_bytes",
        "continuation_ref"
      ],
      "additionalProperties": false,
      "description": "Finite implementation profile supplies maximum limits, query cost and supported filter schema. An unset bound blocks qualification, not validation bypass."
    },
    "ProjectionIdentity": {
      "type": "object",
      "properties": {
        "writer_epoch": {
          "$ref": "#/$defs/RevisionRef"
        },
        "canonical_cut": {
          "$ref": "#/$defs/RevisionRef"
        },
        "projection_revision": {
          "$ref": "#/$defs/RevisionRef"
        },
        "schema_digest": {
          "$ref": "#/$defs/Digest"
        },
        "audience_revision": {
          "$ref": "#/$defs/RevisionRef"
        },
        "configuration_revision": {
          "$ref": "#/$defs/RevisionRef"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        }
      },
      "required": [
        "writer_epoch",
        "canonical_cut",
        "projection_revision",
        "schema_digest",
        "audience_revision",
        "configuration_revision",
        "snapshot_ref",
        "coverage"
      ],
      "additionalProperties": false
    },
    "Status": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "status-projection"
        },
        "candidate_version": {
          "const": "r-l-candidate/0"
        },
        "identity": {
          "$ref": "#/$defs/ProjectionIdentity"
        },
        "current_goal": {
          "$ref": "#/$defs/Observation"
        },
        "authority_epoch": {
          "$ref": "#/$defs/Observation"
        },
        "pending_interactions": {
          "$ref": "#/$defs/Observation"
        },
        "queue_state": {
          "$ref": "#/$defs/Observation"
        },
        "budget": {
          "$ref": "#/$defs/Observation"
        },
        "route": {
          "$ref": "#/$defs/Observation"
        },
        "configuration": {
          "$ref": "#/$defs/Observation"
        },
        "freshness": {
          "$ref": "#/$defs/Observation"
        }
      },
      "required": [
        "kind",
        "candidate_version",
        "identity",
        "current_goal",
        "authority_epoch",
        "pending_interactions",
        "queue_state",
        "budget",
        "route",
        "configuration",
        "freshness"
      ],
      "additionalProperties": false,
      "description": "Each projection/version supplies payload schemas for known values. No GUI-only state can become canonical through this envelope."
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "receipt-facts"
        },
        "candidate_version": {
          "const": "r-l-candidate/0"
        },
        "command_id": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "operation_id": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "saved_locally": {
          "$ref": "#/$defs/Observation"
        },
        "accepted_refused": {
          "$ref": "#/$defs/Observation"
        },
        "dispatched": {
          "$ref": "#/$defs/Observation"
        },
        "delivered_applied": {
          "$ref": "#/$defs/Observation"
        },
        "outcome_observed": {
          "$ref": "#/$defs/Observation"
        },
        "effects_settled_unresolved": {
          "$ref": "#/$defs/Observation"
        },
        "independent_verification": {
          "$ref": "#/$defs/Observation"
        },
        "accounting": {
          "$ref": "#/$defs/Observation"
        }
      },
      "required": [
        "kind",
        "candidate_version",
        "command_id",
        "operation_id",
        "saved_locally",
        "accepted_refused",
        "dispatched",
        "delivered_applied",
        "outcome_observed",
        "effects_settled_unresolved",
        "independent_verification",
        "accounting"
      ],
      "additionalProperties": false,
      "description": "Concurrent evidence dimensions, not one lifecycle badge. Semantic constraints and allowed source classes are enforced by independent admission/reduction."
    },
    "Capability": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "semantic_version": {
          "type": "string",
          "minLength": 1
        },
        "declared": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "authorized": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "route_supported": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "observed_conformance": {
          "enum": [
            "qualified-profile",
            "unqualified",
            "unknown"
          ]
        },
        "presently_usable": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "supplying_component_ref": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "semantic_version",
        "declared",
        "enabled",
        "authorized",
        "route_supported",
        "observed_conformance",
        "presently_usable",
        "supplying_component_ref",
        "reason"
      ],
      "additionalProperties": false
    },
    "Negotiation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "capability-description"
        },
        "candidate_version": {
          "const": "r-l-candidate/0"
        },
        "catalog_revision": {
          "$ref": "#/$defs/RevisionRef"
        },
        "catalog_digest": {
          "$ref": "#/$defs/Digest"
        },
        "schema_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Digest"
          }
        },
        "projection_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "authority_revision": {
          "$ref": "#/$defs/RevisionRef"
        },
        "configuration_revision": {
          "$ref": "#/$defs/RevisionRef"
        },
        "route_revision": {
          "$ref": "#/$defs/RevisionRef"
        }
      },
      "required": [
        "kind",
        "candidate_version",
        "catalog_revision",
        "catalog_digest",
        "schema_digests",
        "projection_versions",
        "capabilities",
        "authority_revision",
        "configuration_revision",
        "route_revision"
      ],
      "additionalProperties": false,
      "description": "Application capability description. Does not amend M1B HELLO/WELCOME or authorize any operation."
    },
    "Interaction": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "interaction-record"
        },
        "candidate_version": {
          "const": "r-l-candidate/0"
        },
        "interaction_id": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "generation": {
          "$ref": "#/$defs/RevisionRef"
        },
