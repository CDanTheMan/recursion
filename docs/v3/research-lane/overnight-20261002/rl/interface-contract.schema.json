      "type": "object",
      "properties": {
        "requested_value": {},
        "effective_value": {},
        "source_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpaqueRef"
          }
        },
        "source_revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionRef"
          }
        },
