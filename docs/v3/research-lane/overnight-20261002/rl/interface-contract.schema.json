          "$ref": "#/$defs/Target"
        },
        "request_action_digest": {
          "$ref": "#/$defs/Digest"
        },
        "respondent_ref": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "audience_ref": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "exact_scope_ref": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "revision": {
          "$ref": "#/$defs/RevisionRef"
        },
        "created_sequence": {
          "$ref": "#/$defs/RevisionRef"
        },
        "expiry_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpaqueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "answer_schema_digest": {
          "$ref": "#/$defs/Digest"
        },
        "state": {
          "enum": [
            "pending",
            "answered",
            "cancelled",
            "expired",
            "superseded"
          ]
        },
        "reply_delivery_generation": {
          "$ref": "#/$defs/RevisionRef"
        }
      },
      "required": [
        "kind",
        "candidate_version",
        "interaction_id",
        "generation",
        "interaction_kind",
        "target",
        "request_action_digest",
        "respondent_ref",
        "audience_ref",
        "exact_scope_ref",
        "revision",
        "created_sequence",
        "expiry_ref",
        "answer_schema_digest",
        "state",
        "reply_delivery_generation"
      ],
      "additionalProperties": false,
      "description": "Approval scope reference resolves exact action, recipient, data and consequential parameters. It cannot be supplied by a renderer as authority."
    },
