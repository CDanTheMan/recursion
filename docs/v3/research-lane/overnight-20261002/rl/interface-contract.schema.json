          "type": "string",
          "minLength": 1
        },
        "constraint_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority_impact": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": [
            "live",
            "checkpoint-applied",
            "restart-required",
            "goal-frozen"
          ]
        },
        "application_boundary": {
          "type": "string",
          "minLength": 1
        },
        "blocked": {
          "type": "boolean"
        }
      },
      "required": [
        "requested_value",
        "effective_value",
        "source_scopes",
        "source_revisions",
        "merge_operator",
        "constraint_reasons",
        "authority_impact",
        "lifecycle",
        "application_boundary",
        "blocked"
      ],
      "additionalProperties": false
    },
    "Config": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "config-transaction"
        },
        "candidate_version": {
          "const": "r-l-candidate/0"
        },
        "command_id": {
          "$ref": "#/$defs/OpaqueRef"
