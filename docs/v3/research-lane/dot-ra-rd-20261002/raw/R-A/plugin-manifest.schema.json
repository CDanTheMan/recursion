{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:recursion:plugin-manifest:proposal-0",
  "title": "Proposed PluginManifest epoch 0 structural schema",
  "description": "RESEARCH DESIGN ONLY. Structural validation cannot enforce resource containment, granting, revocation, effect settlement, or plugin isolation. Not an accepted runtime schema.",
  "type": "object",
  "required": [
    "schema_epoch",
    "contract_revision",
    "identity",
    "compatibility",
    "contributions",
    "requires",
    "admission_contract_ref",
    "attenuation",
    "privacy",
    "bounds",
    "evidence_contract",
    "dependencies",
    "extensions"
  ],
  "properties": {
    "schema_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "contract_revision": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "id",
        "version",
        "payload_digest",
        "source_pin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "payload_digest": {
          "type": "string",
          "minLength": 1
        },
        "source_pin": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "canonical_epoch",
        "required_features",
        "profile_refs"
      ],
      "properties": {
        "canonical_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "required_features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "profile_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "descriptor_revision",
          "input_schema_ref",
          "output_schema_ref",
          "binding_ref",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "descriptor_revision": {
            "type": "integer",
            "minimum": 1
          },
          "input_schema_ref": {
            "type": "string"
          },
          "output_schema_ref": {
            "type": "string"
          },
          "binding_ref": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "operations",
          "resources",
          "effects",
          "purpose",
          "conditions"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "purpose": {
            "type": "string"
          },
          "conditions": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "admission_contract_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Contract identifier only. Actual grant_ref belongs to the detached InstallationRecord; immutable author manifest bytes are never mutated."
    },
    "attenuation": {
      "type": "object",
      "required": [
        "delegation",
        "max_depth",
        "parent_containment_required"
      ],
      "properties": {
        "delegation": {
          "enum": [
            "forbidden",
            "attenuated-only"
          ]
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0
        },
        "parent_containment_required": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": [
        "accepted_labels",
        "emitted_labels",
        "compartments",
        "purposes",
        "recipients",
        "retention_ref",
        "unknown_label"
      ],
      "properties": {
        "accepted_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "emitted_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "compartments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "retention_ref": {
          "type": "string"
        },
        "unknown_label": {
          "const": "deny"
        }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": [
        "provider_calls",
        "billing",
        "egress",
        "unknown_required_bound"
      ],
      "properties": {
        "provider_calls": {
          "type": "object"
        },
        "process_starts": {
          "type": "object"
        },
        "external_effects": {
          "type": "object"
        },
        "output": {
          "type": "object"
        },
        "billing": {
          "type": "object"
        },
        "egress": {
          "type": "object"
        },
        "unknown_required_bound": {
          "const": "refuse"
        }
      },
      "additionalProperties": false
    },
    "evidence_contract": {
      "type": "object",
      "required": [
        "schema_ref",
        "required_fields",
        "completion_is_acceptance",
        "independent_review_ref",
        "missing_required_evidence"
      ],
      "properties": {
        "schema_ref": {
          "type": "string"
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "completion_is_acceptance": {
          "const": false
        },
        "independent_review_ref": {
          "type": "string"
        },
        "missing_required_evidence": {
          "const": "unverified"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "range",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "range": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced adapter data; semantic constraints forbid authority overrides."
    }
  },
  "additionalProperties": false
}
