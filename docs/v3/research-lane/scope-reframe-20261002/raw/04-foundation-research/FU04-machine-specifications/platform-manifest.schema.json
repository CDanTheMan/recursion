        "display_status",
        "required_fixture_ids",
        "required_owner_inputs",
        "evidence_refs",
        "unknowns"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scope_decision": {
                "const": "owner_excluded"
              }
            },
            "required": [
              "scope_decision"
            ]
          },
          "then": {
            "properties": {
              "owner_decision_ref": {
                "type": "string",
                "minLength": 1
              },
              "qualification": {
                "const": "rejected"
              },
              "display_status": {
                "const": "Rejected"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pin_state": {
                "const": "pending"
              }
            },
            "required": [
              "pin_state"
            ]
          },
          "then": {
            "properties": {
              "profile_key": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "pin_state": {
                    "const": "pending"
                  }
                },
                "required": [
                  "pin_state"
                ]
              },
              {
                "not": {
                  "properties": {
                    "scope_decision": {
                      "const": "owner_excluded"
                    }
                  },
                  "required": [
                    "scope_decision"
                  ]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "qualification": {
                "const": "unknown"
              },
              "display_status": {
                "const": "Unqualified"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pin_state": {
                "const": "pinned"
              }
            },
            "required": [
              "pin_state"
            ]
          },
          "then": {
            "properties": {
              "profile_key": {
                "type": "string",
                "pattern": "^fu04-p1:sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "qualification": {
                "const": "qualified"
              }
            },
            "required": [
              "qualification"
            ]
