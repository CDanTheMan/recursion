{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FU04 Platform Manifest Version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "fu04-platform-manifest-v1"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "contract_status": {
      "enum": [
        "proposed_unexecuted",
        "preregistered",
        "executed_pending_review",
        "accepted"
      ]
    },
    "contract_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      },
      "minItems": 1
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "as_of",
    "contract_status",
    "contract_digest",
    "profiles",
    "results"
  ],
  "$defs": {
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "state",
            "value",
            "evidence_refs"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "retirement_evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "state",
            "reason",
            "retirement_evidence"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "not_applicable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "state",
            "reason",
            "evidence_refs"
          ]
        }
      ]
    },
    "tri": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "enum": [
            "true",
            "false",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "evidence_refs",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "enum": [
                  "true",
                  "false"
                ]
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
