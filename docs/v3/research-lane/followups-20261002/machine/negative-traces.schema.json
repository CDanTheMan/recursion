{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "const": "fu04-negative-traces-v1"
    },
    "status": {
      "const": "proposed_unexecuted"
    },
    "preregistration_required": {
      "const": true
    },
    "fixtures": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "fixture_version": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "shared_protocol": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "type": "string",
            "minLength": 1
          },
          "injected_fault": {
            "type": "string",
            "minLength": 1
          },
          "observation_oracle": {
            "type": "string",
            "minLength": 1
          },
          "recovery_oracle": {
            "type": "string",
            "minLength": 1
          },
          "stop_condition": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "const": "inferred"
          },
          "execution_status": {
            "const": "unexecuted"
          },
          "requires_frozen_local_parameters": {
            "const": true
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^S[0-9]{2}$"
            }
          }
        },
        "required": [
          "fixture_id",
          "fixture_version",
          "title",
          "shared_protocol",
          "prerequisites",
          "injected_fault",
          "observation_oracle",
          "recovery_oracle",
          "stop_condition",
          "evidence_class",
          "execution_status",
          "requires_frozen_local_parameters",
          "source_ids"
        ]
      }
    }
  },
  "required": [
    "catalog_version",
    "status",
    "preregistration_required",
    "fixtures"
  ]
}
